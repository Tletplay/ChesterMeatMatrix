@model IEnumerable<ChesterMeatMatrix.Models.Product>
@{
    ViewBag.Title = "Pallet Details - Chester Meat Matrix";
    Layout = "~/Views/Shared/_ReceiverLayout.cshtml";
    var pallet = ViewBag.Pallet as ChesterMeatMatrix.Models.Product;
    var q = ViewBag.Query as string ?? Request.QueryString["q"] ?? string.Empty;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Chester Meat Matrix - Pallet Details</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0A2540 0%, #1A4A7A 50%, #2C6E9E 100%);
            position: relative;
            overflow-x: hidden;
            padding: 40px 20px;
        }

        /* Blue Bubble Pattern Overlay */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(circle at 20% 40%, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 30px 30px;
            pointer-events: none;
        }

        /* Floating Bubbles */
        .bubble {
            position: absolute;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.05));
            border-radius: 50%;
            backdrop-filter: blur(3px);
            animation: floatBubble 12s infinite ease-in-out;
            z-index: 0;
            pointer-events: none;
        }

        @@keyframes floatBubble {
            0%, 100% { transform: translateY(0) translateX(0) scale(1); opacity: 0.4; }
            25% { transform: translateY(-40px) translateX(20px) scale(1.05); opacity: 0.6; }
            50% { transform: translateY(-70px) translateX(-15px) scale(1.1); opacity: 0.7; }
            75% { transform: translateY(-30px) translateX(25px) scale(1.05); opacity: 0.5; }
        }

        .bubble-1 { width: 300px; height: 300px; top: -80px; left: -100px; animation-duration: 14s; }
        .bubble-2 { width: 200px; height: 200px; bottom: -50px; right: -80px; animation-duration: 11s; animation-delay: 1s; }
        .bubble-3 { width: 150px; height: 150px; top: 15%; right: 5%; animation-duration: 16s; animation-delay: 2s; }
        .bubble-4 { width: 250px; height: 250px; bottom: 10%; left: -60px; animation-duration: 18s; animation-delay: 0.5s; }
        .bubble-5 { width: 100px; height: 100px; top: 70%; right: 15%; animation-duration: 10s; animation-delay: 3s; }
        .bubble-6 { width: 180px; height: 180px; top: 80%; left: 10%; animation-duration: 13s; animation-delay: 1.5s; }
        .bubble-7 { width: 120px; height: 120px; top: 20%; left: 20%; animation-duration: 9s; animation-delay: 2.5s; }
        .bubble-8 { width: 80px; height: 80px; bottom: 25%; right: 10%; animation-duration: 8s; animation-delay: 4s; }

        /* Main Container */
        .details-container {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        /* Card Style */
        .card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            padding: 20px 25px;
            border-bottom: none;
        }

        .card-header h2 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0;
        }

        .card-header p {
            font-size: 13px;
            opacity: 0.8;
            margin-top: 5px;
        }

        .card-body {
            padding: 25px;
        }

        /* Pallet Info Section */
        .pallet-info {
            background: #F8FBFE;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid #E0E8F0;
        }

        .pallet-info h3 {
            color: #0A2540;
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: 800;
            border-left: 4px solid #2C6E9E;
            padding-left: 12px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .info-item {
            padding: 10px;
        }

        .info-item .label {
            font-size: 11px;
            text-transform: uppercase;
            color: #4A6F8F;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .info-item .value {
            font-size: 16px;
            font-weight: 700;
            color: #0A2540;
        }

        /* Search Section */
        .search-section {
            background: #F8FBFE;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid #E0E8F0;
        }

        .search-title {
            color: #0A2540;
            font-weight: 700;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .search-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .search-input {
            flex: 1;
            min-width: 250px;
            padding: 12px 16px;
            border: 2px solid #E0E8F0;
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.2s;
        }

        .search-input:focus {
            outline: none;
            border-color: #2C6E9E;
            box-shadow: 0 0 0 3px rgba(44, 110, 158, 0.15);
        }

        .btn-search {
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            border: none;
            border-radius: 30px;
            padding: 12px 24px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(10, 37, 64, 0.3);
        }

        .btn-clear {
            background: #E8F0F8;
            color: #0A2540;
            border: none;
            border-radius: 30px;
            padding: 12px 24px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-clear:hover {
            background: #D0E0F0;
            transform: translateY(-2px);
            text-decoration: none;
            color: #0A2540;
        }

        /* Table Styles */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .data-table thead th {
            background: #F0F4F8;
            color: #0A2540;
            padding: 14px 12px;
            text-align: left;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #E0E8F0;
        }

        .data-table tbody td {
            padding: 12px;
            border-bottom: 1px solid #E8F0F8;
            color: #1A3A5A;
        }

        .data-table tbody tr:hover {
            background: #F8FBFE;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #4A6F8F;
            background: #F8FBFE;
            border-radius: 16px;
            border: 1px solid #E0E8F0;
        }

        .empty-state span {
            font-size: 48px;
            display: block;
            margin-bottom: 15px;
        }

        /* Back Button */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #E8F0F8;
            color: #0A2540;
            border: none;
            border-radius: 30px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            margin-top: 20px;
        }

        .back-link:hover {
            background: #D0E0F0;
            transform: translateY(-2px);
            text-decoration: none;
            color: #0A2540;
        }

        /* Results Count */
        .results-count {
            margin-bottom: 15px;
            font-size: 13px;
            color: #4A6F8F;
        }

        /* Chester Badge */
        .chester-badge {
            text-align: center;
            margin-top: 20px;
            padding: 10px;
            background: rgba(10, 37, 64, 0.9);
            color: white;
            border-radius: 30px;
            font-size: 10px;
            font-weight: bold;
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .data-table thead {
                display: none;
            }
            .data-table tbody tr {
                display: block;
                margin-bottom: 15px;
                border: 1px solid #E0E8F0;
                border-radius: 12px;
                padding: 10px;
            }
            .data-table tbody td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border: none;
                padding: 8px 10px;
            }
            .data-table tbody td::before {
                content: attr(data-label);
                font-weight: 700;
                width: 40%;
            }
            .search-group {
                flex-direction: column;
            }
            .search-input {
                width: 100%;
            }
            .btn-search, .btn-clear {
                width: 100%;
                text-align: center;
            }
            .info-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 15px;
            }
            .card-body {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Blue Floating Bubbles -->
    <div class="bubble bubble-1"></div>
    <div class="bubble bubble-2"></div>
    <div class="bubble bubble-3"></div>
    <div class="bubble bubble-4"></div>
    <div class="bubble bubble-5"></div>
    <div class="bubble bubble-6"></div>
    <div class="bubble bubble-7"></div>
    <div class="bubble bubble-8"></div>

    <div class="details-container">
        <div class="card">
            <div class="card-header">
                <h2>📦 PALLET DETAILS</h2>
                <p>View pallet information and individual items</p>
            </div>
            <div class="card-body">
                <!-- Pallet Information -->
                <div class="pallet-info">
                    <h3>📋 Pallet Summary</h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="label">📦 Pallet Code</div>
                            <div class="value">@(pallet?.PalletCode ?? "N/A")</div>
                        </div>
                        <div class="info-item">
                            <div class="label">🥩 Product Name</div>
                            <div class="value">@(pallet?.Name ?? "N/A")</div>
                        </div>
                        <div class="info-item">
                            <div class="label">🔢 Quantity</div>
                            <div class="value">@(pallet != null ? pallet.Quantity.ToString() : "0") units</div>
                        </div>
                        <div class="info-item">
                            <div class="label">📍 Location</div>
                            <div class="value">@(pallet?.Location ?? "N/A")</div>
                        </div>
                        <div class="info-item">
                            <div class="label">📅 Received At</div>
                            <div class="value">@(pallet != null && pallet.CreatedAt > System.DateTime.MinValue ? pallet.CreatedAt.ToString("dd MMM yyyy HH:mm") : "N/A")</div>
                        </div>
                    </div>
                </div>

                <!-- Search Section -->
                <div class="search-section">
                    <div class="search-title">🔍 Search Pallet Items</div>
                    <div class="search-group">
                        <input type="text" id="searchInput" class="search-input" placeholder="Search by serial number, product code, or name..." value="@q" />
                        <button onclick="searchItems()" class="btn-search">🔎 Search</button>
                        <a href='@Url.Action("Details","Receiver", new { palletCode = pallet?.PalletCode })' class="btn-clear">🗑 Clear</a>
                    </div>
                </div>

                <!-- Results Count -->
                @if (Model != null)
                {
                    <div class="results-count">
                        Showing <strong>@Model.Count()</strong> item(s)
                        @if (!string.IsNullOrWhiteSpace(q))
                        {
                            <text>matching "<strong>@q</strong>"</text>
                        }
                    </div>
                }

                <!-- Pallet Items Table -->
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <span>📦</span>
                        <p>No items found on this pallet.</p>
                        @if (!string.IsNullOrWhiteSpace(q))
                        {
                            <p style="font-size: 12px; margin-top: 10px;">Try a different search term or <a href='@Url.Action("Details","Receiver", new { palletCode = pallet?.PalletCode })' style="color: #2C6E9E;">clear the search</a>.</p>
                        }
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>🔢 Serial Number</th>
                                    <th>📦 Product Code</th>
                                    <th>🥩 Name</th>
                                    <th>📍 Location</th>
                                    <th>📅 Received</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in Model)
                                {
                                    <tr>
                                        <td data-label="Serial Number"><strong>@it.SerialNumber</strong></td>
                                        <td data-label="Product Code">@it.ProductCode</td>
                                        <td data-label="Name">@it.Name</td>
                                        <td data-label="Location">@it.Location</td>
                                        <td data-label="Received">@(it.CreatedAt > System.DateTime.MinValue ? it.CreatedAt.ToString("dd MMM yyyy HH:mm") : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Back Link -->
                <a href="@Url.Action("Index","Receiver")" class="back-link">
                    ← Back to Pallets
                </a>
            </div>
        </div>

        <div class="chester-badge">
            🥩 CHESTER MEAT MATRIX - QUALITY MEAT, DELIVERED FRESH 🥩
        </div>
    </div>

    <script>
        function searchItems(){
            var v = document.getElementById('searchInput').value;
            var url = '@Url.Action("Details","Receiver")' + '?palletCode=' + encodeURIComponent('@(pallet?.PalletCode ?? "")') + '&q=' + encodeURIComponent(v);
            window.location = url;
        }

        // Allow Enter key to trigger search
        document.getElementById('searchInput')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                searchItems();
            }
        });
    </script>
</body>
</html>