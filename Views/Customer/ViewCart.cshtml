﻿@model IEnumerable<ChesterMeatMatrix.Controllers.CartItem>
@{
    ViewBag.Title = "Your Cart - Chester Meat Matrix";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chester Meat Matrix - Your Cart</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0A2540 0%, #1A4A7A 50%, #2C6E9E 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .cart-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .cart-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
            overflow: hidden;
        }

        .cart-header {
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            padding: 20px 25px;
        }

            .cart-header h2 {
                font-size: 24px;
                font-weight: 800;
            }

        .cart-body {
            padding: 25px;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
        }

            .cart-table th {
                background: #F0F4F8;
                padding: 12px;
                text-align: left;
                font-weight: 700;
                color: #0A2540;
                border-bottom: 2px solid #E0E8F0;
            }

            .cart-table td {
                padding: 12px;
                border-bottom: 1px solid #E8F0F8;
                color: #1A3A5A;
            }

            .cart-table tbody tr:hover {
                background: #F8FBFE;
            }

        .qty-input {
            width: 60px;
            padding: 6px;
            border: 2px solid #E0E8F0;
            border-radius: 8px;
            text-align: center;
        }

        .remove-btn {
            background: #DC2626;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 5px 12px;
            cursor: pointer;
        }

            .remove-btn:hover {
                background: #B91C1C;
            }

        .cart-summary {
            margin-top: 20px;
            text-align: right;
            padding: 20px;
            background: #F8FBFE;
            border-radius: 16px;
        }

            .cart-summary h3 {
                color: #0A2540;
                margin-bottom: 10px;
            }

        .total-amount {
            font-size: 28px;
            font-weight: 800;
            color: #2C6E9E;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .btn-continue {
            background: #E8F0F8;
            color: #0A2540;
            border: none;
            border-radius: 30px;
            padding: 12px 24px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-checkout {
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            border: none;
            border-radius: 30px;
            padding: 12px 28px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .empty-cart {
            text-align: center;
            padding: 60px;
            color: #4A6F8F;
        }

            .empty-cart span {
                font-size: 48px;
                display: block;
                margin-bottom: 15px;
            }
    </style>
</head>
<body>
    <div class="cart-container">
        <div class="cart-card">
            <div class="cart-header">
                <h2>🛒 Your Shopping Cart</h2>
            </div>
            <div class="cart-body">
                @{
                    var cartItems = Model ?? new List<ChesterMeatMatrix.Controllers.CartItem>();
                    var total = cartItems.Sum(i => i.Price * i.Quantity);
                }

                @if (!cartItems.Any())
                {
                    <div class="empty-cart">
                        <span>🛒</span>
                        <p>Your cart is empty.</p>
                        <a href="@Url.Action("StartOrder", "Customer")" style="color: #2C6E9E;">Continue Shopping →</a>
                    </div>
                }
                else
                {
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cartItems)
                            {
                                <tr data-id="@item.ProductId">
                                    <td>@item.ProductName</td>
                                    <td>R @item.Price.ToString("F2")</td>
                                    <td>
                                        <input type="number" class="qty-input" value="@item.Quantity" min="1" data-id="@item.ProductId" data-price="@item.Price" />
                                    </td>
                                    <td class="subtotal">R @((item.Price * item.Quantity).ToString("F2"))</td>
                                    <td>
                                        <button class="remove-btn" data-id="@item.ProductId">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="cart-summary">
                        <h3>Order Summary</h3>
                        <p>Subtotal: <strong>R @total.ToString("F2")</strong></p>
                        <p>VAT (15%): <strong>R @((total * 0.15m).ToString("F2"))</strong></p>
                        <p class="total-amount">Total: R @((total * 1.15m).ToString("F2"))</p>
                    </div>

                    <div class="btn-group">
                        <a href="@Url.Action("StartOrder", "Customer")" class="btn-continue">← Continue Shopping</a>
                        <form action="@Url.Action("PlaceOrder", "Customer")" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-checkout">💳 Proceed to Checkout</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // Update quantity
        $('.qty-input').on('change', function() {
            var productId = $(this).data('id');
            var newQty = parseInt($(this).val());
            var price = $(this).data('price');

            if (newQty < 1) {
                $(this).val(1);
                newQty = 1;
            }

            // Update subtotal for this row
            var subtotal = price * newQty;
            $(this).closest('tr').find('.subtotal').text('R ' + subtotal.toFixed(2));

            // Update total in summary (reload page to keep it simple)
            location.reload();
        });

        // Remove item
        $('.remove-btn').on('click', function() {
            var productId = $(this).data('id');
            $.ajax({
                url: '@Url.Action("RemoveFromCart", "Customer")',
                method: 'POST',
                data: { productId: productId },
                success: function() {
                    location.reload();
                }
            });
        });
    </script>
</body>
</html>

