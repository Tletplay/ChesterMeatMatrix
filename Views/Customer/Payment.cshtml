﻿@model ChesterMeatMatrix.Models.Order
@{
    ViewBag.Title = "Payment - Chester Meat Matrix";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cm-payment-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .cm-payment-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 2rem;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .cm-payment-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    /* Left Card */
    .cm-payment-card {
        background: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        border: 1px solid #E8E8E8;
        overflow: hidden;
    }

    .cm-card-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid #EDF2F7;
        background: #FFFFFF;
    }

    .cm-card-header h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: #0A2540;
    }

    .cm-card-header p {
        margin: 0.25rem 0 0;
        font-size: 0.8rem;
        color: #718096;
    }

    .cm-card-body {
        padding: 1.5rem 1.75rem;
    }

    /* Payment Method */
    .cm-payment-methods {
        margin-bottom: 1.5rem;
    }

    .cm-radio-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 0.75rem;
    }

    .cm-radio-group label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: #2D3748;
        padding: 0.6rem 1rem;
        border: 1px solid #E8E8E8;
        border-radius: 12px;
        transition: all 0.2s ease;
        background: #FFFFFF;
    }

    .cm-radio-group label:hover {
        border-color: #C1272D;
        background: #FEF2F2;
    }

    .cm-radio-group input[type="radio"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #C1272D;
    }

    .cm-radio-group .selected {
        border-color: #C1272D;
        background: #FEF2F2;
    }

    /* Info Boxes */
    .cm-info-box {
        border-radius: 12px;
        padding: 1rem;
        margin-top: 1rem;
        border: 1px solid #E8E8E8;
    }

    .cm-info-card {
        background: #F8FAFE;
    }

    .cm-info-eft {
        background: #FEF3C7;
        border-left: 4px solid #F59E0B;
    }

    .cm-info-cash {
        background: #D1FAE5;
        border-left: 4px solid #10B981;
    }

    .cm-info-enterprise {
        background: #DBEAFE;
        border-left: 4px solid #3B82F6;
    }

    .cm-info-box p {
        margin: 0.25rem 0;
        font-size: 0.8rem;
    }

    .cm-info-box strong {
        color: #0A2540;
    }

    /* Pay Button */
    .cm-pay-btn {
        width: 100%;
        padding: 1rem;
        background: #C1272D;
        color: white;
        border: none;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 1.5rem;
    }

    .cm-pay-btn:hover {
        background: #A11E23;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(193, 39, 45, 0.25);
    }

    .cm-pay-btn.loading {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .cm-secure-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-size: 0.7rem;
        color: #A0AEC0;
    }

    /* Right Sidebar */
    .cm-summary-card {
        background: #F9FAFB;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid #EDF2F7;
        position: sticky;
        top: 100px;
    }

    .cm-summary-title {
        font-size: 1rem;
        font-weight: 700;
        color: #0A2540;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #C1272D;
        display: inline-block;
    }

    .cm-summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid #EDF2F7;
    }

    .cm-summary-row:last-child {
        border-bottom: none;
    }

    .cm-summary-label {
        color: #718096;
        font-size: 0.85rem;
    }

    .cm-summary-amount {
        font-weight: 600;
        color: #2D3748;
    }

    .cm-summary-total {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 2px solid #E2E8F0;
        display: flex;
        justify-content: space-between;
        font-size: 1rem;
        font-weight: 800;
        color: #C1272D;
    }

    .cm-order-detail {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid #E2E8F0;
    }

    .cm-order-detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.3rem 0;
        color: #718096;
        font-size: 0.8rem;
    }

    .cm-cancel-link {
        text-align: center;
        margin-top: 2rem;
    }

    .cm-cancel-link a {
        color: #718096;
        font-size: 0.85rem;
        text-decoration: none;
    }

    .cm-cancel-link a:hover {
        color: #C1272D;
    }

    .cm-alert {
        background: #D1FAE5;
        border-left: 4px solid #10B981;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.8rem;
        color: #065F46;
    }

    .cm-alert-error {
        background: #FEE2E2;
        border-left-color: #DC2626;
        color: #991B1B;
    }

    @@media (max-width: 768px) {
        .cm-payment-container {
            padding: 0 1rem;
        }
        .cm-card-body {
            padding: 1rem;
        }
    }
</style>

@{
    var subtotal = Model.Total;
    var vat = subtotal * 0.15m;
    var totalInclusive = subtotal + vat;
    var customer = ChesterMeatMatrix.Data.InMemoryDatabase.Customers.FirstOrDefault(c => c.Id == Model.CustomerId);
}

<div class="cm-payment-container">
    <div class="cm-payment-grid">
        <!-- LEFT COLUMN - Payment Form -->
        <div class="cm-payment-card">
            <div class="cm-card-header">
                <h2>Complete Payment</h2>
                <p>All transactions are secure and encrypted.</p>
            </div>
            <div class="cm-card-body">
                @if (TempData["Message"] != null)
                {
                    <div class="cm-alert">
                        <i class="fas fa-info-circle"></i> @TempData["Message"]
                    </div>
                }

                <div id="paymentError" class="cm-alert cm-alert-error" style="display: none;">
                    <span id="errorMessage"></span>
                </div>

                @using (Html.BeginForm("Payment", "Customer", FormMethod.Post, new { id = "paymentForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.Id)

                    <!-- Payment Method Selection -->
                    <div class="cm-payment-methods">
                        <div class="cm-radio-group" id="methodGroup">
                            <label id="cardLabel">
                                <input type="radio" name="method" value="Card" checked />
                                <span>💳 Credit / Debit Card</span>
                            </label>
                            <label id="eftLabel">
                                <input type="radio" name="method" value="EFT" />
                                <span>🏦 EFT (Bank Transfer)</span>
                            </label>
                            <label id="cashLabel">
                                <input type="radio" name="method" value="Cash" />
                                <span>💵 Cash on Delivery</span>
                            </label>
                            @if (customer != null && customer.CustomerType == ChesterMeatMatrix.Models.CustomerTypeEnum.Enterprise)
                            {
                                <label id="enterpriseLabel">
                                    <input type="radio" name="method" value="Enterprise" />
                                    <span>🏢 Enterprise (Monthly Billing)</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Card Info Box -->
                    <div id="cardInfoBox" class="cm-info-box cm-info-card">
                        <p><strong>💳 Pay with Credit/Debit Card</strong></p>
                        <p>You will be redirected to Stripe's secure payment page to complete your transaction.</p>
                        <p>✅ Visa • Mastercard • American Express accepted</p>
                        <p>🔒 Your payment information is encrypted and secure.</p>
                    </div>

                    <!-- EFT Info Box -->
                    <div id="eftInfoBox" class="cm-info-box cm-info-eft" style="display: none;">
                        <p><strong>🏦 Bank Transfer Details</strong></p>
                        <p>Bank: Chester Meat Bank</p>
                        <p>Account Name: Chester Meat Matrix</p>
                        <p>Account Number: 1234567890</p>
                        <p>Reference: <strong>@Model.OrderNumber</strong></p>
                        <p>Please use your order number as reference. Your order will be confirmed once payment is received.</p>
                    </div>

                    <!-- Cash Info Box -->
                    <div id="cashInfoBox" class="cm-info-box cm-info-cash" style="display: none;">
                        <p><strong>💵 Cash on Delivery</strong></p>
                        <p>Pay in cash when your order arrives at your door.</p>
                        <p>Available for Instore customers only.</p>
                    </div>

                    <!-- Enterprise Info Box -->
                    <div id="enterpriseInfoBox" class="cm-info-box cm-info-enterprise" style="display: none;">
                        <p><strong>🏢 Enterprise (Monthly Billing)</strong></p>
                        <p>This order will be added to your monthly invoice.</p>
                        <p>No payment required now. You will receive an invoice at the end of the month.</p>
                    </div>

                    <button type="submit" class="cm-pay-btn" id="payBtn">
                        <i class="fas fa-lock"></i> Pay R @totalInclusive.ToString("N2")
                    </button>

                    <div class="cm-secure-note">
                        <i class="fas fa-shield-alt"></i> Secure payment gateway
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT COLUMN - Order Summary -->
        <div>
            <div class="cm-summary-card">
                <div class="cm-summary-title">Order Summary</div>

                <div class="cm-summary-row">
                    <span class="cm-summary-label">Subtotal</span>
                    <span class="cm-summary-amount">R @subtotal.ToString("N2")</span>
                </div>
                <div class="cm-summary-row">
                    <span class="cm-summary-label">Shipping</span>
                    <span class="cm-summary-amount">Calculated at checkout</span>
                </div>
                <div class="cm-summary-row">
                    <span class="cm-summary-label">VAT (15%)</span>
                    <span class="cm-summary-amount">R @vat.ToString("N2")</span>
                </div>
                <div class="cm-summary-total">
                    <span>Total</span>
                    <span>R @totalInclusive.ToString("N2")</span>
                </div>

                <div class="cm-order-detail">
                    <div class="cm-order-detail-row">
                        <span>Order #</span>
                        <span><strong>@Model.OrderNumber</strong></span>
                    </div>
                    <div class="cm-order-detail-row">
                        <span>Items</span>
                        <span>@(Model.Items?.Count ?? 0) products</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="cm-cancel-link">
        <a href="@Url.Action("Index", "Customer")">
            <i class="fas fa-arrow-left"></i> Cancel and return to dashboard
        </a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $(document).ready(function() {
        var $methodRadios = $('input[name="method"]');
        var $cardInfoBox = $('#cardInfoBox');
        var $eftInfoBox = $('#eftInfoBox');
        var $cashInfoBox = $('#cashInfoBox');
        var $enterpriseInfoBox = $('#enterpriseInfoBox');
        var $payBtn = $('#payBtn');
        var $paymentForm = $('#paymentForm');
        var totalAmount = @totalInclusive;

        // Highlight selected payment method
        function updateSelectedStyle() {
            var selectedValue = $('input[name="method"]:checked').val();
            $('.cm-radio-group label').removeClass('selected');
            if (selectedValue === 'Card') $('#cardLabel').addClass('selected');
            else if (selectedValue === 'EFT') $('#eftLabel').addClass('selected');
            else if (selectedValue === 'Cash') $('#cashLabel').addClass('selected');
            else if (selectedValue === 'Enterprise') $('#enterpriseLabel').addClass('selected');
        }

        // Toggle info boxes
        function toggleInfoBoxes() {
            var selectedMethod = $('input[name="method"]:checked').val();

            $cardInfoBox.hide();
            $eftInfoBox.hide();
            $cashInfoBox.hide();
            $enterpriseInfoBox.hide();

            if (selectedMethod === 'Card') {
                $cardInfoBox.show();
                $payBtn.html('<i class="fas fa-lock"></i> Pay R ' + totalAmount.toFixed(2));
            } else if (selectedMethod === 'EFT') {
                $eftInfoBox.show();
                $payBtn.html('<i class="fas fa-credit-card"></i> Place Order');
            } else if (selectedMethod === 'Cash') {
                $cashInfoBox.show();
                $payBtn.html('<i class="fas fa-money-bill"></i> Place Order');
            } else if (selectedMethod === 'Enterprise') {
                $enterpriseInfoBox.show();
                $payBtn.html('<i class="fas fa-building"></i> Place Order');
            }

            updateSelectedStyle();
        }

        $methodRadios.on('change', toggleInfoBoxes);
        toggleInfoBoxes();

        // Show loading state on submit
        $paymentForm.on('submit', function() {
            $payBtn.addClass('loading');
            $payBtn.html('PROCESSING...');
        });
    });
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">