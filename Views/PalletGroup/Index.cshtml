﻿@model IEnumerable<ChesterMeatMatrix.Models.PalletGroup>
@{
    ViewBag.Title = "Pallet Groups";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .container-custom {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .header-bar h2 {
            color: #0a4c8c;
            font-weight: 700;
        }

    .groups-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .group-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: transform 0.2s;
    }

        .group-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

    .group-number {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a4c8c;
    }

    .group-stats {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
        color: #64748b;
        font-size: 0.85rem;
    }

    .btn-create {
        background: linear-gradient(135deg, #0a4c8c 0%, #0e6cb0 100%);
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        color: white;
        text-decoration: none;
    }
</style>

<div class="container-custom">
    <div class="header-bar">
        <h2><i class="fas fa-layer-group"></i> Pallet Groups</h2>
        <a href="@Url.Action("Create")" class="btn-create">+ Create New Group</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="fas fa-boxes fa-2x mb-2 d-block"></i>
            <p>No pallet groups created yet.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary">Create Your First Group</a>
        </div>
    }
    else
    {
        <div class="groups-grid">
            @foreach (var group in Model)
            {
                <div class="group-card">
                    <div class="group-number">@group.GroupNumber</div>
                    <div><strong>@group.GroupName</strong></div>
                    <div><small>@group.ProductType</small></div>
                    <div class="group-stats">
                        <span><i class="fas fa-pallet"></i> @(group.Pallets?.Count ?? 0) pallets</span>
                        <span><i class="fas fa-cubes"></i> @group.TotalQuantity units</span>
                        <span><i class="fas fa-map-marker-alt"></i> @group.Location</span>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">Created: @group.CreatedDate.ToString("dd MMM yyyy")</small>
                    </div>
                    <div class="mt-3">
                        <a href="@Url.Action("Details", new { id = group.PalletGroupId })" class="btn btn-sm btn-outline-primary">View Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>