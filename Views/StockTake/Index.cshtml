﻿@using ChesterMeatMatrix.Models
@model IEnumerable<StockTake>
@{
    ViewBag.Title = "Stock Take Sessions";
    Layout = "~/Views/Shared/_WarehouseManagerLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold" style="color: #0A2540; display: flex; align-items: center; gap: 0.75rem;">
                <i data-lucide="clipboard-list" style="color: #C1272D; width: 28px; height: 28px;"></i>
                Stock Take Sessions
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Manage and track inventory counting sessions</p>
        </div>
        <a href="@Url.Action("Create")" class="btn" style="background: #C1272D; color: white; padding: 0.625rem 1.5rem; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; border: none; transition: all 0.2s;">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            Create New Session
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" style="background: #D1FAE5; border: none; border-left: 4px solid #10B981; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
            <i data-lucide="check-circle" style="color: #10B981; width: 20px; height: 20px;"></i>
            <span style="color: #065F46; font-weight: 500;">@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" style="background: #FEE2E2; border: none; border-left: 4px solid #DC2626; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
            <i data-lucide="alert-circle" style="color: #DC2626; width: 20px; height: 20px;"></i>
            <span style="color: #991B1B; font-weight: 500;">@TempData["Error"]</span>
        </div>
    }

    <!-- Stats Row -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 border" style="background: white; border-color: #E8E8E8; border-left: 3px solid #0A2540;">
                    <div style="font-size: 0.7rem; color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total Sessions</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: #0A2540; margin-top: 0.25rem;">@Model.Count()</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 border" style="background: white; border-color: #E8E8E8; border-left: 3px solid #F59E0B;">
                    <div style="font-size: 0.7rem; color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Draft</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: #0A2540; margin-top: 0.25rem;">@Model.Count(s => s.Status == StockTakeStatus.Draft)</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 border" style="background: white; border-color: #E8E8E8; border-left: 3px solid #3B82F6;">
                    <div style="font-size: 0.7rem; color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">In Progress</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: #0A2540; margin-top: 0.25rem;">@Model.Count(s => s.Status == StockTakeStatus.Counting)</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 border" style="background: white; border-color: #E8E8E8; border-left: 3px solid #10B981;">
                    <div style="font-size: 0.7rem; color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Completed</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: #0A2540; margin-top: 0.25rem;">@Model.Count(s => s.Status == StockTakeStatus.Approved)</div>
                </div>
            </div>
        </div>
    }

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4" style="border: 1px solid #E8E8E8; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.875rem;">
                <thead style="background: #F8FAFE; border-bottom: 2px solid #E8E8E8;">
                    <tr>
                        <th style="padding: 0.875rem 1.25rem; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Session</th>
                        <th style="padding: 0.875rem 1.25rem; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Location</th>
                        <th style="padding: 0.875rem 1.25rem; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Start Date</th>
                        <th style="padding: 0.875rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Items Counted</th>
                        <th style="padding: 0.875rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Variances</th>
                        <th style="padding: 0.875rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Status</th>
                        <th style="padding: 0.875rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var session in Model)
                        {
                            string statusBg = session.Status == StockTakeStatus.Draft ? "#FEF3C7" :
                                              session.Status == StockTakeStatus.Counting ? "#DBEAFE" :
                                              session.Status == StockTakeStatus.VariancesIdentified ? "#FEF3C7" :
                                              session.Status == StockTakeStatus.Approved ? "#D1FAE5" :
                                              "#F3F4F6";

                            string statusColor = session.Status == StockTakeStatus.Draft ? "#92400E" :
                                                 session.Status == StockTakeStatus.Counting ? "#1E40AF" :
                                                 session.Status == StockTakeStatus.VariancesIdentified ? "#92400E" :
                                                 session.Status == StockTakeStatus.Approved ? "#065F46" :
                                                 "#6B7280";

                            string statusIcon = session.Status == StockTakeStatus.Draft ? "file-text" :
                                                session.Status == StockTakeStatus.Counting ? "loader-2" :
                                                session.Status == StockTakeStatus.VariancesIdentified ? "alert-triangle" :
                                                session.Status == StockTakeStatus.Approved ? "check-circle" :
                                                "circle";

                            <tr>
                                <td style="padding: 0.875rem 1.25rem; vertical-align: middle;">
                                    <div style="font-weight: 600; color: #0A2540;">@session.Name</div>
                                    <div style="font-size: 0.75rem; color: #94A3B8; margin-top: 0.125rem;">@session.SessionNumber</div>
                                </td>
                                <td style="padding: 0.875rem 1.25rem; vertical-align: middle; color: #1E1E1E;">
                                    <i data-lucide="map-pin" style="width: 14px; height: 14px; color: #94A3B8; margin-right: 0.5rem;"></i>
                                    @session.Location
                                </td>
                                <td style="padding: 0.875rem 1.25rem; vertical-align: middle; color: #1E1E1E;">@session.StartDate.ToString("dd MMM yyyy")</td>
                                <td style="padding: 0.875rem 1.25rem; text-align: center; vertical-align: middle; font-weight: 600; color: #0A2540;">@session.TotalItemsCounted</td>
                                <td style="padding: 0.875rem 1.25rem; text-align: center; vertical-align: middle;">
                                    <span style="font-weight: 700; color: @(session.TotalVariancesFound > 0 ? "#DC2626" : "#10B981");">
                                        @session.TotalVariancesFound
                                    </span>
                                </td>
                                <td style="padding: 0.875rem 1.25rem; text-align: center; vertical-align: middle;">
                                    <span style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.25rem 0.75rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; background: @statusBg; color: @statusColor;">
                                        <i data-lucide="@statusIcon" style="width: 12px; height: 12px;"></i>
                                        @session.Status
                                    </span>
                                </td>
                                <td style="padding: 0.875rem 1.25rem; text-align: center; vertical-align: middle;">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="@Url.Action("Details", new { id = session.StockTakeId })" class="btn btn-sm" style="background: #0A2540; color: white; padding: 0.25rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.375rem;">
                                            <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                                            View
                                        </a>
                                        @if (session.Status == StockTakeStatus.Draft)
                                        {
                                            <a href="@Url.Action("CountSheet", new { id = session.StockTakeId })" class="btn btn-sm" style="background: #F1F5F9; color: #0A2540; padding: 0.25rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.375rem;">
                                                <i data-lucide="printer" style="width: 14px; height: 14px;"></i>
                                                Sheet
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="padding: 3rem 1.25rem; text-align: center; color: #94A3B8;">
                                <i data-lucide="inbox" style="width: 48px; height: 48px; color: #CBD5E1; display: block; margin: 0 auto 0.75rem;"></i>
                                <p style="margin: 0 0 1rem 0; font-size: 1rem; color: #64748B;">No stock take sessions found</p>
                                <a href="@Url.Action("Create")" class="btn" style="background: #C1272D; color: white; padding: 0.5rem 1.5rem; border-radius: 50px; font-weight: 600; font-size: 0.875rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                                    <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                                    Create First Session
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
    lucide.createIcons();
</script>