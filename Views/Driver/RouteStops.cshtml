﻿@using ChesterMeatMatrix.Data
@using ChesterMeatMatrix.Models
@model IEnumerable<ChesterMeatMatrix.Models.Order>
@{
    ViewBag.Title = "Delivery Stops";
    Layout = "~/Views/Shared/_DriverLayout.cshtml";
    var route = ViewBag.Route as ChesterMeatMatrix.Models.Route;
    var routeId = ViewBag.RouteId;
    var totalStops = Model.Count();
    var deliveredStops = Model.Count(o => o.Status == OrderStatusEnum.Delivered);
    var progressPercent = totalStops > 0 ? (deliveredStops * 100 / totalStops) : 0;
}

@Html.AntiForgeryToken()

<style>
    .progress-section {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #E0E8F0;
    }

    .progress-bar {
        height: 12px;
        background: #E2E8F0;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #10B981, #059669);
        border-radius: 20px;
        transition: width 0.3s;
    }

    .stop-card {
        background: white;
        border-radius: 16px;
        margin-bottom: 16px;
        overflow: hidden;
        border: 1px solid #E0E8F0;
        transition: all 0.2s;
    }

        .stop-card.delivered {
            background: #D1FAE5;
            border-color: #10B981;
            opacity: 0.8;
        }

        .stop-card.pending {
            border-left: 4px solid #F59E0B;
        }

        .stop-card.returned {
            background: #FEE2E2;
            border-color: #DC2626;
            opacity: 0.7;
        }

    .stop-header {
        padding: 16px 20px;
        background: #F8FAFE;
        border-bottom: 1px solid #E0E8F0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .stop-number {
        background: #0A2540;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 12px;
    }

    .stop-body {
        padding: 20px;
    }

    .address {
        color: #4A6F8F;
        margin-bottom: 12px;
        word-break: break-word;
    }

    .customer-name {
        font-weight: 700;
        color: #0A2540;
        margin-bottom: 8px;
    }

    .order-details {
        display: flex;
        gap: 20px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #E0E8F0;
    }

    .btn-deliver {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-return {
        background: #DC2626;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        margin-left: 10px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-return:hover {
            background: #B91C1C;
            color: white;
            text-decoration: none;
        }

    .btn-complete {
        background: linear-gradient(135deg, #0A2540, #1A4A7A);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 40px;
        font-weight: 700;
        font-size: 1.1rem;
        width: 100%;
        cursor: pointer;
    }

        .btn-complete:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-delivered {
        background: #D1FAE5;
        color: #065F46;
    }

    .status-pending {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-returned {
        background: #FEE2E2;
        color: #991B1B;
    }

    .map-link {
        color: #2C6E9E;
        text-decoration: none;
        font-size: 13px;
    }

        .map-link:hover {
            text-decoration: underline;
        }

    /* Signature Modal Styles */
    .signature-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .signature-modal {
        background: white;
        border-radius: 20px;
        padding: 25px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

        .signature-modal h3 {
            color: #0A2540;
            margin-bottom: 15px;
        }

    .signature-pad {
        border: 2px dashed #0A2540;
        border-radius: 12px;
        background: white;
        width: 100%;
        height: 200px;
        margin-bottom: 1rem;
    }

        .signature-pad canvas {
            width: 100%;
            height: 100%;
            border-radius: 8px;
            background: white;
            cursor: crosshair;
        }

    .photo-preview {
        max-width: 200px;
        max-height: 150px;
        border-radius: 8px;
        margin-top: 10px;
        border: 1px solid #E0E8F0;
        display: none;
    }

    .modal-buttons {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-modal-submit {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        cursor: pointer;
        flex: 1;
    }

    .btn-modal-clear {
        background: #6B7280;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        cursor: pointer;
        flex: 1;
    }

    .btn-modal-cancel {
        background: #DC2626;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        cursor: pointer;
        flex: 1;
    }

    .photo-optional {
        color: #6B7280;
        font-size: 11px;
        margin-top: 5px;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #0A2540;">Delivery Stops</h2>
        <a href="@Url.Action("MyRoutes", "Driver")" class="btn btn-outline-secondary">← Back to Routes</a>
    </div>

    <!-- Progress Section -->
    <div class="progress-section">
        <div class="d-flex justify-content-between mb-2">
            <span><strong>Route Progress</strong></span>
            <span><strong>@deliveredStops / @totalStops stops completed</strong></span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @progressPercent%"></div>
        </div>
        <div class="text-center mt-3">
            <small class="text-muted">Route: @(route?.Name ?? "N/A") | Scheduled: @(route?.Date > DateTime.MinValue ? route.Date.ToString("dd MMM yyyy HH:mm") : "Date TBD")</small>
        </div>
    </div>

    <!-- Stops List -->
    @{
        int stopNumber = 1;
    }
    @foreach (var order in Model)
    {
        var isDelivered = order.Status == OrderStatusEnum.Delivered;
        var isReturned = order.Status == OrderStatusEnum.Cancelled;
        string cardClass = isDelivered ? "stop-card delivered" : (isReturned ? "stop-card returned" : "stop-card pending");

        <div class="@cardClass" id="stop-@order.Id">
            <div class="stop-header">
                <div>
                    <span class="stop-number">@stopNumber</span>
                    <strong>Order #@order.OrderNumber</strong>
                </div>
                <div>
                    @if (isDelivered)
                    {
                        <span class="status-badge status-delivered">✓ Delivered</span>
                    }
                    else if (isReturned)
                    {
                        <span class="status-badge status-returned">✗ Returned</span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">⏳ Pending</span>
                    }
                </div>
            </div>
            <div class="stop-body">
                <div class="customer-name">
                    <i class="fas fa-user"></i> @(order.Customer?.Name ?? "N/A")
                </div>
                <div class="address">
                    <i class="fas fa-location-dot"></i> @(order.Customer?.Address ?? "No address provided")
                </div>
                <div class="order-details">
                    <div>
                        <small class="text-muted">Items</small><br />
                        <strong>@(order.Items?.Count ?? 0) items</strong>
                    </div>
                    <div>
                        <small class="text-muted">Total</small><br />
                        <strong>R @order.Total.ToString("N2")</strong>
                    </div>
                    <div>
                        <small class="text-muted">Weight</small><br />
                        <strong>@(order.TotalWeightKg > 0 ? order.TotalWeightKg.ToString("F2") + " kg" : "-")</strong>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(order.Customer?.Address ?? "")"
                       target="_blank" class="map-link">
                        <i class="fas fa-map-marker-alt"></i> Open in Google Maps
                    </a>
                </div>
                @if (!isDelivered && !isReturned)
                {
                    <div class="mt-3 text-end">
                        <button class="btn-deliver" onclick="openSignatureModal(@routeId, @order.Id)">
                            <i class="fas fa-check-circle"></i> Mark as Delivered
                        </button>
                        <a href="@Url.Action("ReturnOrder", "Driver", new { routeId = routeId, orderId = order.Id })" class="btn-return">
                            <i class="fas fa-undo-alt"></i> Return
                        </a>
                    </div>
                }
            </div>
        </div>
        stopNumber++;
    }

    <!-- Complete Route Button -->
    <div class="mt-4">
        @{
            var allDelivered = Model.All(o => o.Status == OrderStatusEnum.Delivered);
        }
        <form action="@Url.Action("CompleteDelivery", "Driver")" method="get">
            <input type="hidden" name="routeId" value="@routeId" />
            <button type="submit" class="btn-complete" @(!allDelivered ? "disabled" : "")>
                <i class="fas fa-flag-checkered"></i> Complete Route
            </button>
        </form>
        @if (!allDelivered)
        {
            <p class="text-center text-muted mt-2 small">
                <i class="fas fa-info-circle"></i> Please mark all stops as delivered before completing the route.
            </p>
        }
    </div>
</div>

<!-- Signature & Photo Modal -->
<div id="signatureModal" class="signature-modal-overlay">
    <div class="signature-modal">
        <h3><i class="fas fa-signature"></i> Customer Signature & Delivery Proof</h3>
        <p>Order #: <strong id="modalOrderNumber"></strong></p>

        <div class="form-group">
            <label><i class="fas fa-camera"></i> Delivery Photo <span style="color: #6B7280;">(Optional)</span></label>
            <input type="file" id="deliveryPhotoInput" class="form-control" accept="image/*" />
            <img id="modalPhotoPreview" class="photo-preview" />
            <p class="photo-optional">Photo is optional. You can submit without a photo.</p>
        </div>

        <div class="form-group">
            <label><i class="fas fa-signature"></i> Customer Signature (required)</label>
            <div class="signature-pad">
                <canvas id="modalSignatureCanvas" width="600" height="200" style="width:100%; height:200px;"></canvas>
            </div>
            <button type="button" class="btn-modal-clear" onclick="clearModalCanvas()">Clear Signature</button>
        </div>

        <div class="modal-buttons">
            <button class="btn-modal-cancel" onclick="closeSignatureModal()">Cancel</button>
            <button class="btn-modal-submit" onclick="submitDelivery()">Confirm Delivery</button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var token = '';
    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    if (tokenInput) {
        token = tokenInput.value;
    }

    var currentRouteId = 0;
    var currentOrderId = 0;
    var isDrawing = false;
    var lastX = 0;
    var lastY = 0;

    // Signature Modal Functions
    function openSignatureModal(routeId, orderId) {
        currentRouteId = routeId;
        currentOrderId = orderId;
        $('#modalOrderNumber').text(orderId);

        // Reset form
        $('#deliveryPhotoInput').val('');
        $('#modalPhotoPreview').hide();

        // Initialize canvas with a small delay to ensure it's rendered
        setTimeout(function() {
            initSignatureCanvas();
        }, 100);

        $('#signatureModal').fadeIn(200);
    }

    function closeSignatureModal() {
        $('#signatureModal').fadeOut(200);
        currentRouteId = 0;
        currentOrderId = 0;
    }

    function initSignatureCanvas() {
        var canvas = document.getElementById('modalSignatureCanvas');
        if (!canvas) {
            console.error('Canvas not found');
            return;
        }

        var ctx = canvas.getContext('2d');

        // Set canvas size properly
        var container = canvas.parentElement;
        canvas.width = container.clientWidth - 20;
        canvas.height = 200;

        // Set drawing styles
        ctx.strokeStyle = '#0A2540';
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Fill with white background
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Drawing variables
        isDrawing = false;

        // Mouse events
        canvas.addEventListener('mousedown', function(e) {
            isDrawing = true;
            var rect = canvas.getBoundingClientRect();
            var scaleX = canvas.width / rect.width;
            var scaleY = canvas.height / rect.height;
            lastX = (e.clientX - rect.left) * scaleX;
            lastY = (e.clientY - rect.top) * scaleY;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(lastX, lastY);
            ctx.stroke();
            e.preventDefault();
        });

        canvas.addEventListener('mousemove', function(e) {
            if (!isDrawing) return;
            var rect = canvas.getBoundingClientRect();
            var scaleX = canvas.width / rect.width;
            var scaleY = canvas.height / rect.height;
            var currentX = (e.clientX - rect.left) * scaleX;
            var currentY = (e.clientY - rect.top) * scaleY;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(currentX, currentY);
            ctx.stroke();
            lastX = currentX;
            lastY = currentY;
            e.preventDefault();
        });

        canvas.addEventListener('mouseup', function() {
            isDrawing = false;
        });

        canvas.addEventListener('mouseleave', function() {
            isDrawing = false;
        });

        // Touch events for mobile
        canvas.addEventListener('touchstart', function(e) {
            e.preventDefault();
            var rect = canvas.getBoundingClientRect();
            var touch = e.touches[0];
            var scaleX = canvas.width / rect.width;
            var scaleY = canvas.height / rect.height;
            lastX = (touch.clientX - rect.left) * scaleX;
            lastY = (touch.clientY - rect.top) * scaleY;
            isDrawing = true;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(lastX, lastY);
            ctx.stroke();
        });

        canvas.addEventListener('touchmove', function(e) {
            e.preventDefault();
            if (!isDrawing) return;
            var rect = canvas.getBoundingClientRect();
            var touch = e.touches[0];
            var scaleX = canvas.width / rect.width;
            var scaleY = canvas.height / rect.height;
            var currentX = (touch.clientX - rect.left) * scaleX;
            var currentY = (touch.clientY - rect.top) * scaleY;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(currentX, currentY);
            ctx.stroke();
            lastX = currentX;
            lastY = currentY;
        });

        canvas.addEventListener('touchend', function(e) {
            e.preventDefault();
            isDrawing = false;
        });
    }

    function clearModalCanvas() {
        var canvas = document.getElementById('modalSignatureCanvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = '#0A2540';
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
    }

    // Photo preview (optional)
    $('#deliveryPhotoInput').on('change', function(e) {
        var file = e.target.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                $('#modalPhotoPreview').attr('src', e.target.result).show();
            };
            reader.readAsDataURL(file);
        }
    });

    function submitDelivery() {
        // Get signature
        var canvas = document.getElementById('modalSignatureCanvas');
        if (!canvas) {
            alert('Signature pad error. Please refresh and try again.');
            return;
        }

        var signatureData = canvas.toDataURL('image/png');

        // Check if canvas has drawing (not just white)
        var ctx = canvas.getContext('2d');
        var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        var hasDrawing = false;
        for (var i = 0; i < imageData.data.length; i += 4) {
            // Check if pixel is not white (not 255,255,255)
            if (imageData.data[i] < 250 || imageData.data[i+1] < 250 || imageData.data[i+2] < 250) {
                hasDrawing = true;
                break;
            }
        }

        if (!hasDrawing) {
            alert('Please capture customer signature before confirming delivery.');
            return;
        }

        // Get photo (OPTIONAL)
        var photoFile = $('#deliveryPhotoInput')[0].files[0];

        if (photoFile) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var photoBase64 = e.target.result;
                sendDeliveryRequest(signatureData, photoBase64);
            };
            reader.readAsDataURL(photoFile);
        } else {
            sendDeliveryRequest(signatureData, '');
        }
    }

    function sendDeliveryRequest(signatureData, photoBase64) {
        $.ajax({
            url: '@Url.Action("MarkStopDelivered", "Driver")',
            type: 'POST',
            data: {
                routeId: currentRouteId,
                orderId: currentOrderId,
                signatureData: signatureData,
                deliveryPhotoBase64: photoBase64,
                __RequestVerificationToken: token
            },
            success: function(response) {
                if (response.success) {
                    closeSignatureModal();
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                alert('Error marking stop as delivered: ' + error);
            }
        });
    }
</script>