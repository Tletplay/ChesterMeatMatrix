@model ChesterMeatMatrix.Models.Route
@{
    ViewBag.Title = "Route Details - Driver";
    Layout = "~/Views/Shared/_DriverLayout.cshtml";
    var orders = ViewBag.Orders as List<ChesterMeatMatrix.Models.Order> ?? new List<ChesterMeatMatrix.Models.Order>();
    var driver = ViewBag.Driver as string;
    var vehicle = ViewBag.Vehicle as string;
}

<style>
    .info-row {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #E0E8F0;
    }

    .info-label {
        font-weight: 600;
        width: 140px;
        display: inline-block;
        color: #0A2540;
    }

    .order-card {
        background: #F8FBFE;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
        border: 1px solid #E0E8F0;
    }

        .order-card:hover {
            background: #F0F4F8;
        }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-Delivered {
        background: #D1FAE5;
        color: #059669;
    }

    .status-OutForDelivery {
        background: #FEF3C7;
        color: #D97706;
    }

    .status-Pending {
        background: #FEF3C7;
        color: #D97706;
    }

    .status-Confirmed {
        background: #DBEAFE;
        color: #2563EB;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #0A2540;">Route Details: @Model.Name</h2>
        <a href="@Url.Action("MyRoutes", "Driver")" class="btn btn-outline-secondary">← Back to Routes</a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h4>Route Information</h4>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">📍 Destination:</span>
                        <span>@Model.Destination</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">📅 Scheduled:</span>
                        <span>@(Model.Date > DateTime.MinValue ? Model.Date.ToString("dd MMM yyyy") : "TBD")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">👤 Driver:</span>
                        <span>@driver</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">🚛 Vehicle:</span>
                        <span>@vehicle</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">📦 Total Items:</span>
                        <span>@Model.ItemsCount</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">⚖️ Total Mass:</span>
                        <span>@Model.TotalMassKg.ToString("F2") kg</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">⚙️ Status:</span>
                        <span class="status-badge status-@Model.Status">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-white">
                    <h4>Orders in this Route (@orders.Count orders)</h4>
                </div>
                <div class="card-body">
                    @if (!orders.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p>No orders found in this route.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var order in orders)
                        {
                            <div class="order-card">
                                <div class="row">
                                    <div class="col-md-7">
                                        <strong>Order #@order.OrderNumber</strong><br />
                                        <span>Customer: @order.Customer?.Name</span><br />
                                        <span>Address: @order.Customer?.Address</span>
                                    </div>
                                    <div class="col-md-5 text-end">
                                        <span class="status-badge status-@order.Status">@order.Status</span><br />
                                        <strong>R @order.Total.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">