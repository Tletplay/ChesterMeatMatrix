﻿@model List<ChesterMeatMatrix.Controllers.StockReportItem>
@{
    ViewBag.Title = "Stock Report";
    Layout = "~/Views/Shared/_WarehouseManagerLayout.cshtml";
}

<style>
    * {
        font-family: 'Inter', sans-serif;
    }

    .container-custom {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .header-bar h1 {
            color: #0a4c8c;
            font-weight: 700;
            margin: 0;
        }

    .btn-back {
        background: #64748b;
        padding: 8px 24px;
        border-radius: 40px;
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #475569;
            color: white;
            text-decoration: none;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0a4c8c 0%, #0e6cb0 100%);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 40px;
        color: white;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0e6cb0 0%, #0a4c8c 100%);
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .summary-card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 4px 12px rgba(10, 76, 140, 0.08);
        text-align: center;
    }

        .summary-card .label {
            color: #64748b;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        .summary-card .value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #0a4c8c;
        }

    .report-table {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(10, 76, 140, 0.08);
    }

        .report-table th {
            background: #0a4c8c;
            color: white;
            padding: 1rem;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .report-table td {
            padding: 0.8rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .report-table tr:hover {
            background: #f8fafc;
        }

    .status-out {
        background: #fee2e2;
        color: #991b1b;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-critical {
        background: #fed7aa;
        color: #92400e;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-low {
        background: #fef3c7;
        color: #b45309;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-healthy {
        background: #d1fae5;
        color: #065f46;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .progress-bar {
        width: 80px;
        height: 6px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        display: inline-block;
        margin-left: 0.5rem;
    }

    .progress-fill {
        height: 100%;
        background: #10b981;
        border-radius: 20px;
    }
</style>

<div class="container-custom">
    <div class="header-bar">
        <h1>📊 Stock Report</h1>
        <div style="display: flex; gap: 1rem;">
            <a href="@Url.Action("CheckLowStock")" class="btn-primary">🔍 Check Low Stock</a>
            <a href="@Url.Action("Dashboard")" class="btn-back">← Back to Dashboard</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        int totalProducts = Model.Count;
        int outOfStock = Model.Count(m => m.CurrentStock == 0);
        int lowStock = Model.Count(m => m.CurrentStock > 0 && m.CurrentStock <= m.MinimumThreshold);
        int totalIncoming = Model.Sum(m => m.ExpectedIncoming);
        decimal totalWeight = Model.Sum(m => m.TotalWeightKg);

        <div class="summary-cards">
            <div class="summary-card">
                <div class="label">Total Products</div>
                <div class="value">@totalProducts</div>
            </div>
            <div class="summary-card">
                <div class="label">Out of Stock</div>
                <div class="value" style="color: #ef4444;">@outOfStock</div>
            </div>
            <div class="summary-card">
                <div class="label">Low Stock</div>
                <div class="value" style="color: #f59e0b;">@lowStock</div>
            </div>
            <div class="summary-card">
                <div class="label">Expected Incoming</div>
                <div class="value">@totalIncoming</div>
            </div>
            <div class="summary-card">
                <div class="label">Total Weight</div>
                <div class="value">@totalWeight.ToString("N0") kg</div>
            </div>
        </div>

        <div class="report-table">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Stock</th>
                        <th>Min Threshold</th>
                        <th>Reorder Qty</th>
                        <th>Expected</th>
                        <th>Status</th>
                        <th>Level</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(m => m.Status))
                    {
                        string statusClass = "";
                        if (item.CurrentStock == 0) { statusClass = "status-out"; }
                        else if (item.CurrentStock <= item.MinimumThreshold / 2) { statusClass = "status-critical"; }
                        else if (item.CurrentStock <= item.MinimumThreshold) { statusClass = "status-low"; }
                        else { statusClass = "status-healthy"; }

                        var stockPercentage = item.MinimumThreshold > 0
                            ? Math.Min(100, (int)((double)item.CurrentStock / (item.MinimumThreshold * 2) * 100))
                            : 0;

                        <tr>
                            <td><strong>@item.ProductName</strong></td>
                            <td>@item.CurrentStock units</td>
                            <td>@item.MinimumThreshold</td>
                            <td>@item.ReorderQuantity</td>
                            <td>@item.ExpectedIncoming</td>
                            <td><span class="@statusClass">@item.Status</span></td>
                            <td>
                                @item.CurrentStock / @(item.MinimumThreshold * 2)
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @stockPercentage%;"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="background: white; border-radius: 20px; padding: 3rem; text-align: center; color: #64748b;">
            <h3>No stock data available</h3>
            <p>Please ensure products have been added and stock batches have been received.</p>
            <br />
            <a href="@Url.Action("CheckLowStock")" class="btn-primary">Check Low Stock</a>
        </div>
    }
</div>