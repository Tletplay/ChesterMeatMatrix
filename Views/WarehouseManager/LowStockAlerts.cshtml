﻿@model List<ChesterMeatMatrix.Models.LowStockAlert>
@{
    ViewBag.Title = "Low Stock Alerts";
    Layout = "~/Views/Shared/_WarehouseManagerLayout.cshtml";
    var currentStatus = ViewBag.Status as string ?? "Pending";
    var statusOptions = ViewBag.StatusOptions as string[] ?? new[] { "Pending", "Approved", "Rejected", "Ordered", "Received" };
}

<style>
    * {
        font-family: 'Inter', sans-serif;
    }

    .container-custom {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .header-bar h1 {
            color: #0a4c8c;
            font-weight: 700;
            margin: 0;
        }

    .btn-back {
        background: #64748b;
        padding: 8px 24px;
        border-radius: 40px;
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #475569;
            color: white;
            text-decoration: none;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0a4c8c 0%, #0e6cb0 100%);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 40px;
        color: white;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0e6cb0 0%, #0a4c8c 100%);
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        background: white;
        padding: 1rem;
        border-radius: 20px;
    }

    .filter-tab {
        padding: 0.6rem 1.5rem;
        border-radius: 40px;
        text-decoration: none;
        color: #64748b;
        font-weight: 500;
        background: #f1f5f9;
        transition: all 0.2s;
    }

        .filter-tab:hover {
            background: #e2e8f0;
            color: #0a4c8c;
            text-decoration: none;
        }

        .filter-tab.active {
            background: linear-gradient(135deg, #0a4c8c 0%, #0e6cb0 100%);
            color: white;
        }

    .alerts-table {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(10, 76, 140, 0.08);
    }

        .alerts-table th {
            background: #0a4c8c;
            color: white;
            padding: 1rem;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .alerts-table td {
            padding: 0.8rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .alerts-table tr:hover {
            background: #f8fafc;
        }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending {
        background: #fef3c7;
        color: #b45309;
    }

    .status-approved {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-ordered {
        background: #e0e7ff;
        color: #3730a3;
    }

    .status-received {
        background: #d1fae5;
        color: #065f46;
    }

    .btn-review {
        background: linear-gradient(135deg, #0a4c8c 0%, #0e6cb0 100%);
        border: none;
        padding: 0.3rem 1rem;
        border-radius: 20px;
        color: white;
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
    }

        .btn-review:hover {
            background: linear-gradient(135deg, #0e6cb0 0%, #0a4c8c 100%);
            color: white;
            text-decoration: none;
        }

    .critical-badge {
        background: #ef4444;
        color: white;
        padding: 0.15rem 0.5rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    .warning-badge {
        background: #f59e0b;
        color: white;
        padding: 0.15rem 0.5rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }
</style>

<div class="container-custom">
    <div class="header-bar">
        <h1>⚠️ Low Stock Alerts</h1>
        <div style="display: flex; gap: 1rem;">
            <a href="@Url.Action("CheckLowStock")" class="btn-primary">🔍 Check for New Alerts</a>
            <a href="@Url.Action("Dashboard")" class="btn-back">← Back to Dashboard</a>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        @foreach (var status in statusOptions)
        {
            string activeClass = (status == currentStatus) ? "active" : "";
            <a href="@Url.Action("LowStockAlerts", new { status = status })" class="filter-tab @activeClass">
                @status
            </a>
        }
    </div>

    <!-- Alerts Table -->
    <div class="alerts-table">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Alert Date</th>
                    <th>Product</th>
                    <th>Current Stock</th>
                    <th>Threshold</th>
                    <th>Suggested Order</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var alert in Model)
                    {
                        var isCritical = alert.CurrentStockQuantity == 0;
                        var isWarning = alert.CurrentStockQuantity > 0 && alert.CurrentStockQuantity <= alert.ThresholdLevel / 2;
                        string productName = alert.Product != null ? alert.Product.Name : "Unknown";
                        string statusClass = GetStatusClass(alert.AlertStatus);

                        <tr>
                            <td>@alert.AlertDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td><strong>@productName</strong></td>
                            <td>
                                @alert.CurrentStockQuantity
                                @if (isCritical)
                                {
                                    <span class="critical-badge">OUT OF STOCK</span>
                                }
                                else if (isWarning)
                                {
                                    <span class="warning-badge">CRITICAL</span>
                                }
                            </td>
                            <td>@alert.ThresholdLevel</td>
                            <td>@alert.SuggestedOrderQuantity</td>
                            <td><span class="status-badge @statusClass">@alert.AlertStatus</span></td>
                            <td>
                                @if (alert.AlertStatus == "Pending")
                                {
                                    <a href="@Url.Action("ReviewAlert", new { id = alert.LowStockAlertId })" class="btn-review">Review</a>
                                }
                                else
                                {
                                    <span style="color: #64748b; font-size: 0.7rem;">
                                        @(alert.ReviewedBy?.Split('@')[0] ?? "N/A")<br />
                                        <small>@(alert.ReviewedDate?.ToString("dd MMM") ?? "")</small>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 3rem; color: #64748b;">
                            No @currentStatus.ToLower() alerts found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "";
        if (status == "Pending") return "status-pending";
        if (status == "Approved") return "status-approved";
        if (status == "Rejected") return "status-rejected";
        if (status == "Ordered") return "status-ordered";
        if (status == "Received") return "status-received";
        return "";
    }
}