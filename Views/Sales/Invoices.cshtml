﻿@model IEnumerable<ChesterMeatMatrix.Models.Order>
@{
    ViewBag.Title = "Invoices";
    Layout = "~/Views/Shared/_SalesLayout.cshtml";
    var search = ViewBag.Search as string ?? "";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<style>
    .filter-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #E0E8F0;
    }

    .btn-filter {
        background: linear-gradient(135deg, #0A2540, #1A4A7A);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-weight: 600;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 16px;
        overflow: hidden;
    }

        .data-table th {
            background: #F0F4F8;
            padding: 12px;
            text-align: left;
            font-weight: 700;
        }

        .data-table td {
            padding: 12px;
            border-bottom: 1px solid #E0E8F0;
        }

    .status-paid {
        background: #D1FAE5;
        color: #059669;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-unpaid {
        background: #FEF3C7;
        color: #D97706;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #0A2540;">Invoices</h2>
        <a href="@Url.Action("Index", "Sales")" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <!-- Filter Section -->
    <div class="filter-card">
        @using (Html.BeginForm("Invoices", "Sales", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">🔍 Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Order #, Invoice # or Customer" value="@search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">📅 From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">📅 To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@toDate" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn-filter w-100">Apply Filter</button>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="fas fa-file-invoice fa-2x mb-2 d-block"></i>
            <p>No invoices found.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@(order.InvoiceNumber ?? "-")</td>
                            <td>@order.Customer?.Name</td>
                            <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>R @order.Total.ToString("N2")</td>
                            <td>
                                @if (order.IsPaid)
                                {
                                    <span class="status-paid">Paid</span>
                                }
                                else
                                {
                                    <span class="status-unpaid">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">