﻿@model IEnumerable<ChesterMeatMatrix.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Manage Staff";
}

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
            <h3 style="margin: 0;">👥 Staff Members</h3>
            <p style="margin: 5px 0 0; font-size: 13px;">View, edit, and manage team members</p>
        </div>
        <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-primary btn-sm">
            ➕ Create New Staff Account
        </a>
    </div>
    <div class="card-body" style="padding: 0; overflow-x: auto;">
        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
                <span style="font-size: 48px; display: block; margin-bottom: 15px;">👥</span>
                <p>No staff members found.</p>
                <p style="font-size: 12px;">Click the button above to create your first staff account.</p>
            </div>
        }
        else
        {
            <table class="data-table" style="width: 100%;">
                <thead>
                    <tr>
                        <th>📧 Username</th>
                        <th>👤 Full Name</th>
                        <th>⚙️ Role</th>
                        <th>🔧 Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var roleClass = u.Role == "Admin" ? "role-Admin" :
                                        u.Role == "Checker" ? "role-Checker" :
                                        u.Role == "Warehouse" ? "role-Warehouse" :
                                        u.Role == "SalesRep" ? "role-SalesRep" :
                                        u.Role == "Router" ? "role-Router" : "role-Receiver";
                        <tr>
                            <td data-label="Username">@u.Username</td>
                            <td data-label="Full Name">@u.FullName</td>
                            <td data-label="Role">
                                <span class="role-badge @roleClass">@u.Role</span>
                            </td>
                            <td data-label="Actions">
                                <div style="display: flex; gap: 8px;">
                                    <a href="@Url.Action("EditUser", "Admin", new { id = u.Id })" class="btn btn-secondary btn-sm" style="background: var(--navy-medium); padding: 5px 15px;">✏️ Edit</a>
                                    @using (Html.BeginForm("DeleteUser", "Admin", FormMethod.Post, new { onsubmit = "return confirm('⚠️ Are you sure you want to delete this user? This action cannot be undone.');", style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", u.Id)
                                        <button type="submit" class="btn-sm" style="background: #DC2626; color: white; border: none; padding: 5px 15px; border-radius: var(--radius-full); cursor: pointer;">🗑 Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .role-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .role-Admin {
        background: var(--navy-dark);
        color: white;
    }

    .role-Checker {
        background: var(--navy-light);
        color: white;
    }

    .role-Warehouse {
        background: var(--navy-medium);
        color: white;
    }

    .role-SalesRep {
        background: #0D5C7E;
        color: white;
    }

    .role-Router {
        background: #1E6B8F;
        color: white;
    }

    .role-Receiver {
        background: #2A7A9E;
        color: white;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            text-align: left;
            padding: 14px 15px;
            background: var(--off-white);
            font-size: 12px;
            font-weight: 700;
            color: var(--navy-dark);
            text-transform: uppercase;
            border-bottom: 2px solid var(--gray-light);
        }

        .data-table td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--gray-light);
            font-size: 13px;
        }

        .data-table tr:hover {
            background: var(--off-white);
        }

    @@media (max-width: 768px) {
        .data-table thead {
            display: none;
        }

        .data-table tbody tr {
            display: block;
            margin-bottom: 15px;
            border: 1px solid var(--gray-light);
            border-radius: 12px;
            padding: 10px;
        }

        .data-table tbody td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: none;
            padding: 8px 10px;
        }

            .data-table tbody td::before {
                content: attr(data-label);
                font-weight: 700;
                width: 40%;
            }
    }
</style>