﻿@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Create Staff Account";
}

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header">
        <h3 style="margin: 0;">👥 Create Staff Account</h3>
        <p style="margin: 5px 0 0; font-size: 13px;">Add new team member to Chester Meat Matrix</p>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("CreateUser", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>👤 Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter username" required />
            </div>

            <div class="form-group">
                <label>🔒 Password</label>
                <input type="password" name="password" class="form-control" placeholder="Create a password" required />
            </div>

            <div class="form-group">
                <label>📝 Full Name</label>
                <input type="text" name="fullname" class="form-control" placeholder="Enter staff full name" required />
            </div>

            <div class="form-group">
                <label>⚙️ Role</label>
                <select name="role" class="form-control">
                    <option value="Checker">📋 Checker</option>
                    <option value="Warehouse">🏭 Warehouse</option>
                    <option value="SalesRep">💰 Sales Representative</option>
                    <option value="Router">🚚 Router</option>
                    <option value="Receiver">📦 Receiver</option>
                    <option value="Admin">👑 Admin</option>
                </select>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 25px;">
                <button type="submit" class="btn btn-primary">👥 CREATE ACCOUNT</button>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">✖ CANCEL</a>
            </div>
        }

        @Html.ValidationSummary(true)
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 12px;
            color: var(--navy-dark);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid var(--gray-light);
        border-radius: var(--radius-md);
        font-size: 14px;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--red-primary);
            box-shadow: 0 0 0 3px rgba(193, 39, 45, 0.15);
        }

    select.form-control {
        cursor: pointer;
    }
</style>