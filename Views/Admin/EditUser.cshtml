﻿@model ChesterMeatMatrix.Models.User
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Staff Account";
}

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header">
        <h3 style="margin: 0;">✏️ Edit Staff Account</h3>
        <p style="margin: 5px 0 0; font-size: 13px;">Update team member information</p>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="form-group">
                <label>👤 Username</label>
                <input type="text" name="username" value="@Model.Username" class="form-control" placeholder="Enter username" required />
            </div>

            <div class="form-group">
                <label>🔒 Password</label>
                <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current password" />
                <small style="font-size: 11px; color: var(--text-secondary);">Leave blank to keep existing password</small>
            </div>

            <div class="form-group">
                <label>📝 Full Name</label>
                <input type="text" name="fullname" value="@Model.FullName" class="form-control" placeholder="Enter staff full name" required />
            </div>

            <div class="form-group">
                <label>⚙️ Role</label>
                <select name="role" class="form-control">
                    <option value="Admin" @(Model.Role == "Admin" ? "selected" : "")>👑 Admin</option>
                    <option value="Checker" @(Model.Role == "Checker" ? "selected" : "")>📋 Checker</option>
                    <option value="Warehouse" @(Model.Role == "Warehouse" ? "selected" : "")>🏭 Warehouse</option>
                    <option value="SalesRep" @(Model.Role == "SalesRep" ? "selected" : "")>💰 Sales Representative</option>
                    <option value="Router" @(Model.Role == "Router" ? "selected" : "")>🚚 Router</option>
                    <option value="Receiver" @(Model.Role == "Receiver" ? "selected" : "")>📦 Receiver</option>
                </select>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 25px;">
                <button type="submit" class="btn btn-primary">💾 SAVE CHANGES</button>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">✖ CANCEL</a>
            </div>
        }

        @Html.ValidationSummary(true)
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 12px;
            color: var(--navy-dark);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid var(--gray-light);
        border-radius: var(--radius-md);
        font-size: 14px;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--red-primary);
            box-shadow: 0 0 0 3px rgba(193, 39, 45, 0.15);
        }

    select.form-control {
        cursor: pointer;
    }

    small {
        display: block;
        margin-top: 5px;
    }
</style>