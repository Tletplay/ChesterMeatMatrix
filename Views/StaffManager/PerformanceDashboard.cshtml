@using ChesterMeatMatrix.Models
@model IEnumerable<Performance>
@{
    ViewBag.Title = "Performance Dashboard";
    Layout = "~/Views/Shared/_WarehouseManagerLayout.cshtml";

    // Data Processing for Layout Visuals
    var performanceList = Model?.ToList() ?? new List<Performance>();
    var totalStaffCount = ViewBag.TotalStaff ?? performanceList.Count;
    var avgScore = ViewBag.AverageScore ?? (performanceList.Any() ? performanceList.Average(p => p.OverallScore) : 0);

    // Performance Distribution Calculation
    var highPerformers = performanceList.Count(p => p.OverallScore >= 80);
    var midPerformers = performanceList.Count(p => p.OverallScore >= 60 && p.OverallScore < 80);
    var lowPerformers = performanceList.Count(p => p.OverallScore < 60);

    // Team Metric Averages
    var avgAccuracy = performanceList.Any() ? Math.Round(performanceList.Average(p => (double)p.AccuracyRate), 1) : 0;
    var avgPunctuality = performanceList.Any() ? Math.Round(performanceList.Average(p => (double)p.Punctuality), 1) : 0;
    var avgTasks = performanceList.Any() ? Math.Round(performanceList.Average(p => p.TasksCompleted), 1) : 0;
    var avgEfficiency = performanceList.Any() ? Math.Min(100, Math.Round(performanceList.Average(p => (double)p.Efficiency) * 20, 1)) : 0;

    // Top 5 Performers
    var topPerformers = performanceList.OrderByDescending(p => p.OverallScore).Take(5).ToList();
}

<script src="https://unpkg.com/lucide@latest"></script>

<style>
    /* ============================================================
       PERFORMANCE DASHBOARD - MODERNIZED GRID DESIGN
       ============================================================ */

    .perf-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0;
    }

    /* Header */
    .perf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .perf-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0A2540;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

        .perf-title i {
            color: #C1272D;
        }

    .perf-back {
        color: #718096;
        font-size: 0.8rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: color 0.2s;
    }

        .perf-back:hover {
            color: #C1272D;
        }

    /* Stats Row */
    .perf-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 768px) {
        .perf-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .perf-stats {
            grid-template-columns: 1fr;
        }
    }

    .perf-stat {
        background: white;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        border: 1px solid #EDF2F7;
    }

    .perf-stat-label {
        font-size: 0.6rem;
        font-weight: 600;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.2rem;
    }

    .perf-stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0A2540;
        line-height: 1.2;
    }

    .perf-stat-number-large {
        font-size: 1.75rem;
        font-weight: 800;
        color: #0A2540;
    }

    .perf-stat-number-gold {
        color: #D97706;
        display: flex;
        align-items: center;
    }

    .perf-stat-sub {
        font-size: 0.65rem;
        color: #9CA3AF;
        margin-top: 0.2rem;
    }

    /* Top row: 2 charts + compact ranking, side by side */
    .perf-grid-top {
        display: grid;
        grid-template-columns: 1fr 1fr 300px;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        align-items: stretch;
    }

    @@media (max-width: 1100px) {
        .perf-grid-top {
            grid-template-columns: 1fr 1fr;
        }

            .perf-grid-top > .perf-ranking-card {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width: 700px) {
        .perf-grid-top {
            grid-template-columns: 1fr;
        }
    }

    /* Cards */
    .perf-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #EDF2F7;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
    }

    .perf-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        gap: 0.5rem;
    }

    .perf-card-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #0A2540;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .perf-card-sub {
        font-size: 0.7rem;
        color: #9CA3AF;
    }

    .chart-box-h {
        position: relative;
        height: 190px;
    }

    /* Compact Top Performers card */
    .perf-ranking-card {
        min-width: 0;
    }

    .ranking-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .ranking-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.6rem;
        border: 1px solid #F3F4F6;
        border-radius: 10px;
    }

    .ranking-badge {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #F3F4F6;
        color: #4B5563;
        font-weight: 700;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ranking-item:nth-child(1) .ranking-badge {
        background: #C1272D;
        color: white;
    }

    .ranking-item:nth-child(2) .ranking-badge {
        background: #0A2540;
        color: white;
    }

    .ranking-item:nth-child(3) .ranking-badge {
        background: #1A4A7A;
        color: white;
    }

    .ranking-info {
        flex-grow: 1;
        min-width: 0;
    }

    .ranking-name-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.7rem;
        margin-bottom: 0.25rem;
        gap: 0.4rem;
    }

    .ranking-name {
        font-weight: 600;
        color: #0A2540;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ranking-score {
        font-weight: 700;
        color: #0A2540;
        flex-shrink: 0;
    }

    .ranking-bar-bg {
        width: 100%;
        height: 5px;
        background: #F3F4F6;
        border-radius: 3px;
        overflow: hidden;
    }

    .ranking-bar-fill {
        height: 100%;
        border-radius: 3px;
        background: #C1272D;
        transition: width 0.5s ease;
    }

    /* Table & Search - full width on its own row */
    .perf-table-wrap {
        background: white;
        border-radius: 12px;
        border: 1px solid #EDF2F7;
        overflow: hidden;
    }

    .table-toolbar {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #EDF2F7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        background: #FAFBFC;
        flex-wrap: wrap;
    }

    .table-search {
        position: relative;
        max-width: 280px;
        width: 100%;
    }

        .table-search input {
            width: 100%;
            padding: 0.4rem 0.75rem 0.4rem 2rem;
            border-radius: 6px;
            border: 1px solid #E2E8F0;
            font-size: 0.75rem;
            outline: none;
        }

            .table-search input:focus {
                border-color: #C1272D;
            }

        .table-search i {
            position: absolute;
            left: 0.6rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9CA3AF;
        }

    .perf-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .perf-table th {
            text-align: left;
            padding: 0.6rem 0.75rem;
            background: #F9FAFB;
            font-weight: 600;
            color: #6B7280;
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border-bottom: 1px solid #EDF2F7;
        }

        .perf-table td {
            padding: 0.65rem 0.75rem;
            border-bottom: 1px solid #F3F4F6;
            vertical-align: middle;
        }

        .perf-table tr:hover td {
            background: #FAFBFC;
        }

        .perf-table .col-score {
            font-weight: 700;
        }

        .perf-table .td-name {
            font-weight: 600;
            color: #0A2540;
            display: block;
        }

        .perf-table .td-role {
            font-size: 0.6rem;
            color: #9CA3AF;
            display: block;
        }

    .perf-dot-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .perf-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    .perf-dot-green {
        background: #10B981;
    }

    .perf-dot-amber {
        background: #F59E0B;
    }

    .perf-dot-red {
        background: #EF4444;
    }

    .perf-badge {
        display: inline-block;
        padding: 0.15rem 0.6rem;
        border-radius: 12px;
        font-size: 0.6rem;
        font-weight: 600;
    }

    .perf-badge-excellent {
        background: #D1FAE5;
        color: #065F46;
    }

    .perf-badge-good {
        background: #DBEAFE;
        color: #1E40AF;
    }

    .perf-badge-satisfactory {
        background: #FEF3C7;
        color: #92400E;
    }

    .perf-badge-needs {
        background: #FEE2E2;
        color: #991B1B;
    }

    .perf-review-btn {
        padding: 0.25rem 0.81rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
        background: #C1272D;
        color: white;
        border: none;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        display: inline-block;
    }

        .perf-review-btn:hover {
            background: #A11E23;
            color: white;
            text-decoration: none;
        }

    .perf-empty {
        text-align: center;
        padding: 2rem;
        color: #9CA3AF;
    }
</style>

<div class="perf-container">
    <!-- Header -->
    <div class="perf-header">
        <h2 class="perf-title"><i data-lucide="bar-chart-3" style="width: 20px; height: 20px;"></i> Performance</h2>
        <a href="@Url.Action("Dashboard", "StaffManager")" class="perf-back"><i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i> Dashboard</a>
    </div>

    <!-- Stats Row -->
    <div class="perf-stats">
        <div class="perf-stat">
            <div class="perf-stat-label">Total Staff</div>
            <div class="perf-stat-number">@totalStaffCount</div>
        </div>
        <div class="perf-stat">
            <div class="perf-stat-label">Average Score</div>
            <div class="perf-stat-number-large">@(Math.Round((decimal)avgScore, 1))%</div>
        </div>
        <div class="perf-stat">
            <div class="perf-stat-label">Top Performer</div>
            <div class="perf-stat-number perf-stat-number-gold">
                <i data-lucide="trophy" style="width: 14px; height: 14px; margin-right: 0.25rem; color: #D97706;"></i> @(ViewBag.TopPerformer ?? "N/A")
            </div>
        </div>
        <div class="perf-stat">
            <div class="perf-stat-label">Reviews</div>
            <div class="perf-stat-number">@performanceList.Count</div>
            <div class="perf-stat-sub">this period</div>
        </div>
    </div>

    <!-- Top Row: 2 Charts + Compact Top Performers -->
    <div class="perf-grid-top">
        <!-- 1. Team Metrics Comparison -->
        <div class="perf-card">
            <div class="perf-card-header">
                <div>
                    <h3 class="perf-card-title"><i data-lucide="sliders-horizontal" style="width: 16px; height: 16px;"></i> Team Performance Metrics</h3>
                    <span class="perf-card-sub">Average breakdown across key indicators</span>
                </div>
            </div>
            <div class="chart-box-h">
                <canvas id="metricsComparisonChart"></canvas>
            </div>
        </div>

        <!-- 2. Performance Distribution -->
        <div class="perf-card">
            <div class="perf-card-header">
                <div>
                    <h3 class="perf-card-title"><i data-lucide="pie-chart" style="width: 16px; height: 16px;"></i> Performance Distribution</h3>
                    <span class="perf-card-sub">Workforce performance breakdown</span>
                </div>
            </div>
            <div class="chart-box-h">
                <canvas id="distributionChart"></canvas>
            </div>
        </div>

        <!-- 3. Compact Top Performers -->
        <div class="perf-card perf-ranking-card">
            <div class="perf-card-header">
                <div>
                    <h3 class="perf-card-title"><i data-lucide="award" style="width: 16px; height: 16px;"></i> Top Performers</h3>
                    <span class="perf-card-sub">Highest scoring</span>
                </div>
                @if (topPerformers.Any())
                {
                    <i data-lucide="crown" style="width: 16px; height: 16px; color: #C1272D; flex-shrink: 0;"></i>
                }
            </div>
            <div class="ranking-list">
                @if (topPerformers.Any())
                {
                    int rank = 1;
                    foreach (var staff in topPerformers)
                    {
                        var fillWidth = Math.Min(100, Math.Max(10, staff.OverallScore));
                        <div class="ranking-item">
                            <div class="ranking-badge">@rank</div>
                            <div class="ranking-info">
                                <div class="ranking-name-row">
                                    <span class="ranking-name">@(staff.Staff?.FullName ?? "Unknown")</span>
                                    <span class="ranking-score">@Math.Round(staff.OverallScore, 1)%</span>
                                </div>
                                <div class="ranking-bar-bg">
                                    <div class="ranking-bar-fill" style="width: @fillWidth%;"></div>
                                </div>
                            </div>
                        </div>
                        rank++;
                    }
                }
                else
                {
                    <div class="perf-empty">No data available.</div>
                }
            </div>
        </div>
    </div>

    <!-- Full-width Staff Table -->
    <div class="perf-table-wrap">
        <div class="table-toolbar">
            <span style="font-size: 0.8rem; font-weight: 700; color: #0A2540;">All Staff Performance</span>
            <div class="table-search">
                <i data-lucide="search" style="width: 12px; height: 12px;"></i>
                <input type="text" id="staffSearchInput" onkeyup="filterStaffTable()" placeholder="Search staff member or role...">
            </div>
        </div>
        <table class="perf-table" id="staffTable">
            <thead>
                <tr>
                    <th>Staff</th>
                    <th class="col-score">Score</th>
                    <th>Rating</th>
                    <th>Accuracy</th>
                    <th>Punctuality</th>
                    <th>Tasks</th>
                    <th>Eff.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (performanceList.Any())
                {
                    foreach (var p in performanceList.OrderByDescending(x => x.OverallScore))
                    {
                        string badgeClass = p.OverallRating == PerformanceRating.Excellent ? "perf-badge-excellent" :
                                            p.OverallRating == PerformanceRating.Good ? "perf-badge-good" :
                                            p.OverallRating == PerformanceRating.Satisfactory ? "perf-badge-satisfactory" :
                                            "perf-badge-needs";

                        string dotClass = p.AccuracyRate >= 80 ? "perf-dot-green" :
                                          p.AccuracyRate >= 60 ? "perf-dot-amber" : "perf-dot-red";

                        string punctDot = p.Punctuality >= 80 ? "perf-dot-green" :
                                          p.Punctuality >= 60 ? "perf-dot-amber" : "perf-dot-red";

                        <tr>
                            <td>
                                <span class="td-name">@(p.Staff?.FullName ?? "Unknown")</span>
                                <span class="td-role">@(p.Staff?.Role ?? "Staff")</span>
                            </td>
                            <td><span class="col-score">@Math.Round(p.OverallScore, 1)%</span></td>
                            <td><span class="perf-badge @badgeClass">@p.OverallRating</span></td>
                            <td><span class="perf-dot-indicator"><span class="perf-dot @dotClass"></span> @p.AccuracyRate%</span></td>
                            <td><span class="perf-dot-indicator"><span class="perf-dot @punctDot"></span> @p.Punctuality%</span></td>
                            <td>@p.TasksCompleted</td>
                            <td>@p.Efficiency.ToString("F1")</td>
                            <td style="text-align:right;">
                                <a href="@Url.Action("PerformanceReview", new { id = p.PerformanceId })" class="perf-review-btn">Review</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="perf-empty"><i data-lucide="bar-chart-3" style="width: 16px; height: 16px;"></i> No performance data available.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var ctxMetrics = document.getElementById('metricsComparisonChart').getContext('2d');
        new Chart(ctxMetrics, {
            type: 'bar',
            data: {
                labels: ['Accuracy', 'Punctuality', 'Efficiency', 'Task Completion'],
                datasets: [{
                    data: [@avgAccuracy, @avgPunctuality, @avgEfficiency, Math.min(100, @avgTasks * 10)],
                    backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#8B5CF6'],
                    borderRadius: 6,
                    barThickness: 14
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function(ctx) { return ctx.parsed.x + '% Avg'; } } }
                },
                scales: {
                    x: { beginAtZero: true, max: 100, grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { callback: function(v) { return v + '%'; }, font: { size: 10 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 10, weight: '600' } } }
                }
            }
        });

        var ctxDist = document.getElementById('distributionChart').getContext('2d');
        new Chart(ctxDist, {
            type: 'doughnut',
            data: {
                labels: ['High (≥80%)', 'Mid (60-79%)', 'Low (<60%)'],
                datasets: [{
                    data: [@highPerformers, @midPerformers, @lowPerformers],
                    backgroundColor: ['#10B981', '#F59E0B', '#EF4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } },
                    tooltip: { callbacks: { label: function(ctx) { return ' ' + ctx.label + ': ' + ctx.parsed + ' staff'; } } }
                },
                cutout: '65%'
            }
        });

        lucide.createIcons();
    });

    function filterStaffTable() {
        var input = document.getElementById("staffSearchInput");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("staffTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var tdName = tr[i].getElementsByTagName("td")[0];
            if (tdName) {
                var txtValue = tdName.textContent || tdName.innerText;
                tr[i].style.display = txtValue.toLowerCase().indexOf(filter) > -1 ? "" : "none";
            }
        }
    }
</script>