@using ChesterMeatMatrix.Data
@using ChesterMeatMatrix.Models
@model IEnumerable<Shift>
@{
    ViewBag.Title = "Schedule Management";
    Layout = "~/Views/Shared/_WarehouseManagerLayout.cshtml";
    var staff = ViewBag.Staff as List<User>;
    var shiftTypes = ViewBag.ShiftTypes as List<SelectListItem>;
    var startOfWeek = ViewBag.StartOfWeek as DateTime? ?? DateTime.Today;
    var endOfWeek = ViewBag.EndOfWeek as DateTime? ?? startOfWeek.AddDays(6);
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold" style="color: #0A2540; display: flex; align-items: center; gap: 0.75rem;">
                <i data-lucide="calendar" style="color: #C1272D; width: 28px; height: 28px;"></i>
                Schedule Management
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Build and manage your warehouse shifts</p>
        </div>
        <a href="@Url.Action("Dashboard", "StaffManager")" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #64748B; text-decoration: none; font-size: 0.875rem; transition: color 0.2s;" onmouseover="this.style.color='#C1272D'" onmouseout="this.style.color='#64748B'">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            Back to Dashboard
        </a>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" style="position: fixed; top: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 12px; max-width: 380px; width: 100%; pointer-events: none;"></div>

    <!-- Week Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("Schedule", "StaffManager", new { startDate = startOfWeek.AddDays(-7) })" style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 1rem; background: #F1F5F9; color: #0A2540; border-radius: 50px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s;" onmouseover="this.style.background='#E2E8F0'" onmouseout="this.style.background='#F1F5F9'">
                <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
                Prev Week
            </a>
            <span style="font-weight: 700; color: #0A2540; font-size: 1rem; min-width: 140px; text-align: center;">
                @startOfWeek.ToString("dd MMM") – @endOfWeek.ToString("dd MMM yyyy")
            </span>
            <a href="@Url.Action("Schedule", "StaffManager", new { startDate = startOfWeek.AddDays(7) })" style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 1rem; background: #F1F5F9; color: #0A2540; border-radius: 50px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s;" onmouseover="this.style.background='#E2E8F0'" onmouseout="this.style.background='#F1F5F9'">
                Next Week
                <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
            </a>
        </div>
        <div class="d-flex gap-2">
            <a href="#createShiftForm" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.5rem; background: #C1272D; color: white; border: none; border-radius: 50px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.2s; text-decoration: none;" onmouseover="this.style.background='#A11E23'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(193,39,45,0.25)'" onmouseout="this.style.background='#C1272D'; this.style.transform='none'; this.style.boxShadow='none'">
                <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
                Create Shift
            </a>
            @if (Model != null && Model.Any(s => s.Status == ShiftStatus.Draft))
            {
                <button onclick="openPublishConfirmModal()" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.5rem; background: #10B981; color: white; border: none; border-radius: 50px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#059669'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(16,185,129,0.3)'" onmouseout="this.style.background='#10B981'; this.style.transform='none'; this.style.boxShadow='none'">
                    <i data-lucide="upload" style="width: 16px; height: 16px;"></i>
                    Publish Schedule
                </button>
                <form id="publishForm" method="post" action="@Url.Action("PublishSchedule")" style="display: none;">
                    @Html.AntiForgeryToken()
                </form>
            }
        </div>
    </div>

    <!-- Calendar Overview -->
    <div style="background: white; border-radius: 16px; border: 1px solid #E8E8E8; overflow: hidden; margin-bottom: 1.5rem;">
        <div style="padding: 1rem 1.25rem; background: #F8FAFE; border-bottom: 1px solid #E8E8E8;">
            <h3 style="margin: 0; font-size: 0.875rem; font-weight: 700; color: #0A2540; display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="grid" style="width: 18px; height: 18px; color: #C1272D;"></i>
                Schedule Overview
            </h3>
        </div>
        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #E8E8E8; padding: 1px;">
            @{
                var days = new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" };
                for (int i = 0; i < 7; i++)
                {
                    var currentDate = startOfWeek.AddDays(i);
                    var dayShifts = Model != null ? Model.Where(s => s.ShiftDate.Date == currentDate.Date).ToList() : new List<Shift>();
                    var isToday = currentDate.Date == DateTime.Today.Date;

                    <div style="background: white; padding: 0.75rem; min-height: 120px;">
                        <div style="font-size: 0.65rem; font-weight: 700; color: @(isToday ? "#C1272D" : "#94A3B8"); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">
                            @days[i]
                            <span style="display: inline-block; background: @(isToday ? "#C1272D" : "transparent"); color: @(isToday ? "white" : "#0A2540"); width: 22px; height: 22px; border-radius: 50%; text-align: center; line-height: 22px; font-size: 0.7rem; font-weight: 700; margin-left: 4px;">
                                @currentDate.Day
                            </span>
                        </div>
                        @if (dayShifts.Any())
                        {
                            foreach (var shift in dayShifts)
                            {
                                var timeRange = shift.Type == ShiftType.Morning ? "06:00–14:00" :
                                                shift.Type == ShiftType.Afternoon ? "14:00–22:00" : "22:00–06:00";

                                var statusColor = shift.Status == ShiftStatus.Draft ? "#F59E0B" : "#3B82F6";

                                <div style="background: #F8FAFE; border-radius: 8px; padding: 0.375rem 0.5rem; margin-bottom: 0.375rem; border-left: 3px solid @statusColor;">
                                    <div style="font-size: 0.7rem; font-weight: 600; color: #0A2540;">@shift.Name</div>
                                    <div style="font-size: 0.6rem; color: #94A3B8;">@timeRange</div>
                                    <div style="font-size: 0.55rem; font-weight: 600; color: @statusColor; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.125rem;">
                                        @shift.Status
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="font-size: 0.6rem; color: #CBD5E1; text-align: center; padding: 0.5rem 0;">No shifts</div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Create Shift Form -->
    <div id="createShiftForm" style="background: white; border-radius: 16px; border: 1px solid #E8E8E8; overflow: hidden; margin-bottom: 1.5rem;">
        <div style="padding: 1rem 1.25rem; background: #F8FAFE; border-bottom: 1px solid #E8E8E8;">
            <h3 style="margin: 0; font-size: 0.875rem; font-weight: 700; color: #0A2540; display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="plus-circle" style="width: 18px; height: 18px; color: #C1272D;"></i>
                Create New Shift
            </h3>
        </div>
        <div style="padding: 1.25rem;">
            <form method="post" action="@Url.Action("CreateShift")" class="row g-3">
                @Html.AntiForgeryToken()

                <div class="col-md-3">
                    <label style="display: block; font-size: 0.7rem; font-weight: 700; color: #0A2540; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.375rem;">
                        Date <span style="color: #C1272D;">*</span>
                    </label>
                    <input type="date" name="shiftDate" required style="width: 100%; padding: 0.625rem 0.875rem; border: 2px solid #E8E8E8; border-radius: 10px; font-size: 0.875rem; transition: all 0.2s; font-family: inherit; background: white;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#E8E8E8'; this.style.boxShadow='none'" />
                </div>

                <div class="col-md-2">
                    <label style="display: block; font-size: 0.7rem; font-weight: 700; color: #0A2540; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.375rem;">
                        Shift Type <span style="color: #C1272D;">*</span>
                    </label>
                    <select name="shiftType" required style="width: 100%; padding: 0.625rem 0.875rem; border: 2px solid #E8E8E8; border-radius: 10px; font-size: 0.875rem; transition: all 0.2s; font-family: inherit; background: white;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#E8E8E8'; this.style.boxShadow='none'">
                        @if (shiftTypes != null)
                        {
                            foreach (var type in shiftTypes)
                            {
                                <option value="@type.Value">@type.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label style="display: block; font-size: 0.7rem; font-weight: 700; color: #0A2540; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.375rem;">
                        Shift Name
                    </label>
                    <input type="text" name="shiftName" placeholder="e.g., Morning Team - Picking" style="width: 100%; padding: 0.625rem 0.875rem; border: 2px solid #E8E8E8; border-radius: 10px; font-size: 0.875rem; transition: all 0.2s; font-family: inherit; background: white;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#E8E8E8'; this.style.boxShadow='none'" />
                </div>

                <div class="col-md-2">
                    <label style="display: block; font-size: 0.7rem; font-weight: 700; color: #0A2540; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.375rem;">Notes</label>
                    <input type="text" name="notes" placeholder="Optional notes" style="width: 100%; padding: 0.625rem 0.875rem; border: 2px solid #E8E8E8; border-radius: 10px; font-size: 0.875rem; transition: all 0.2s; font-family: inherit; background: white;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#E8E8E8'; this.style.boxShadow='none'" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" style="width: 100%; padding: 0.625rem 1.5rem; background: #C1272D; color: white; border: none; border-radius: 10px; font-weight: 600; font-size: 0.875rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; transition: all 0.2s;" onmouseover="this.style.background='#A11E23'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(193,39,45,0.25)'" onmouseout="this.style.background='#C1272D'; this.style.transform='none'; this.style.boxShadow='none'">
                        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                        Add Shift
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Detailed Schedule Table -->
    <div style="background: white; border-radius: 16px; border: 1px solid #E8E8E8; overflow: hidden;">
        <div style="padding: 1rem 1.25rem; background: #F8FAFE; border-bottom: 1px solid #E8E8E8; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3 style="margin: 0; font-size: 0.875rem; font-weight: 700; color: #0A2540; display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="list" style="width: 18px; height: 18px; color: #C1272D;"></i>
                Detailed Schedule
            </h3>
            <span style="font-size: 0.75rem; color: #94A3B8;">@(Model != null ? Model.Count() : 0) shifts this week</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                <thead>
                    <tr style="background: #FAFBFC; border-bottom: 2px solid #E8E8E8;">
                        <th style="padding: 0.75rem 1.25rem; text-align: left; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Date</th>
                        <th style="padding: 0.75rem 1.25rem; text-align: left; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Shift</th>
                        <th style="padding: 0.75rem 1.25rem; text-align: left; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Time</th>
                        <th style="padding: 0.75rem 1.25rem; text-align: left; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Staff Assigned</th>
                        <th style="padding: 0.75rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Status</th>
                        <th style="padding: 0.75rem 1.25rem; text-align: center; font-weight: 700; color: #0A2540; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var shift in Model)
                        {
                            var timeRange = shift.Type == ShiftType.Morning ? "06:00 – 14:00" :
                                            shift.Type == ShiftType.Afternoon ? "14:00 – 22:00" : "22:00 – 06:00";

                            var assignedStaff = InMemoryDatabase.ShiftAssignments
                                .Where(a => a.ShiftId == shift.ShiftId)
                                .Select(a => InMemoryDatabase.Users.FirstOrDefault(u => u.Id == a.StaffId))
                                .Where(u => u != null)
                                .ToList();

                            string statusBg = shift.Status == ShiftStatus.Draft ? "#FEF3C7" :
                                              shift.Status == ShiftStatus.Published ? "#DBEAFE" :
                                              "#D1FAE5";

                            string statusColor = shift.Status == ShiftStatus.Draft ? "#92400E" :
                                                 shift.Status == ShiftStatus.Published ? "#1E40AF" :
                                                 "#065F46";

                            string statusIcon = shift.Status == ShiftStatus.Draft ? "file-text" :
                                                shift.Status == ShiftStatus.Published ? "check-circle" :
                                                "check-circle";

                            var isLocked = shift.Status == ShiftStatus.Published;

                            <tr style="border-bottom: 1px solid #E8E8E8; transition: background 0.15s ease;" onmouseover="this.style.background='#F8FAFE'" onmouseout="this.style.background='transparent'">
                                <td style="padding: 0.75rem 1.25rem; vertical-align: middle; font-weight: 600; color: #0A2540;">@shift.ShiftDate.ToString("dd MMM yyyy")</td>
                                <td style="padding: 0.75rem 1.25rem; vertical-align: middle;">
                                    <div style="font-weight: 600; color: #0A2540;">@shift.Type</div>
                                    @if (!string.IsNullOrEmpty(shift.Name))
                                    {
                                        <div style="font-size: 0.75rem; color: #94A3B8; margin-top: 0.125rem;">@shift.Name</div>
                                    }
                                </td>
                                <td style="padding: 0.75rem 1.25rem; vertical-align: middle; color: #1E1E1E;">
                                    <i data-lucide="clock" style="width: 14px; height: 14px; color: #94A3B8; margin-right: 0.375rem;"></i>
                                    @timeRange
                                </td>
                                <td style="padding: 0.75rem 1.25rem; vertical-align: middle;">
                                    @if (assignedStaff.Any())
                                    {
                                        foreach (var s in assignedStaff)
                                        {
                                            var initials = string.Join("", s.FullName.Split(' ').Select(n => n[0])).ToUpper();
                                            <span class="staff-chip" style="display: inline-flex; align-items: center; gap: 0.375rem; background: #DBEAFE; padding: 0.125rem 0.5rem; border-radius: 20px; margin: 0.125rem; border: 1px solid #BFDBFE;">
                                                <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; background: #1E40AF; color: white; border-radius: 50%; font-size: 0.6rem; font-weight: 700;">@initials</span>
                                                <span style="font-size: 0.75rem; color: #1E40AF; font-weight: 500;">@s.FullName</span>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #94A3B8; font-size: 0.8rem;">No staff assigned</span>
                                    }
                                </td>
                                <td style="padding: 0.75rem 1.25rem; text-align: center; vertical-align: middle;">
                                    <span style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.25rem 0.75rem; border-radius: 50px; font-size: 0.7rem; font-weight: 600; background: @statusBg; color: @statusColor;">
                                        <i data-lucide="@statusIcon" style="width: 12px; height: 12px;"></i>
                                        @shift.Status
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1.25rem; text-align: center; vertical-align: middle;">
                                    @if (!isLocked)
                                    {
                                        <div class="staff-picker-wrapper" style="position: relative; display: inline-block;">
                                            <button class="staff-picker-toggle" data-shiftid="@shift.ShiftId" style="padding: 0.25rem 0.75rem; border-radius: 8px; border: 1px solid #D1D5DB; font-size: 0.75rem; background: white; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.375rem; font-family: inherit;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'">
                                                <i data-lucide="user-plus" style="width: 14px; height: 14px;"></i>
                                                Assign Staff
                                                <i data-lucide="chevron-down" style="width: 14px; height: 14px;"></i>
                                            </button>
                                            <div class="staff-picker-dropdown" style="display: none; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.12); border: 1px solid #E8E8E8; min-width: 260px; max-height: 300px; overflow: hidden; z-index: 1000; animation: dropdownIn 0.15s ease;">
                                                <div style="padding: 0.75rem; border-bottom: 1px solid #E8E8E8;">
                                                    <div style="position: relative;">
                                                        <i data-lucide="search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 14px; height: 14px; color: #94A3B8;"></i>
                                                        <input type="text" class="staff-search" placeholder="Search staff..." style="width: 100%; padding: 0.375rem 0.75rem 0.375rem 2rem; border: 1px solid #E8E8E8; border-radius: 8px; font-size: 0.8rem; transition: all 0.2s; font-family: inherit; background: white;" onfocus="this.style.borderColor='#C1272D'; this.style.boxShadow='0 0 0 3px rgba(193,39,45,0.1)'" onblur="this.style.borderColor='#E8E8E8'; this.style.boxShadow='none'">
                                                    </div>
                                                </div>
                                                <div class="staff-list" style="max-height: 220px; overflow-y: auto; padding: 0.25rem 0;">
                                                    @if (staff != null)
                                                    {
                                                        foreach (var s in staff)
                                                        {
                                                            var isAssigned = assignedStaff.Any(a => a.Id == s.Id);
                                                            var initials = string.Join("", s.FullName.Split(' ').Select(n => n[0])).ToUpper();
                                                            <div class="staff-option" data-staffid="@s.Id" data-shiftid="@shift.ShiftId" data-name="@s.FullName" data-initials="@initials" style="padding: 0.5rem 0.75rem; cursor: pointer; transition: background 0.15s; display: flex; align-items: center; gap: 0.625rem; @(isAssigned ? "opacity: 0.4; cursor: not-allowed;" : "")" onmouseover="if(!this.style.opacity || this.style.opacity !== '0.4') this.style.background='#F8FAFE'" onmouseout="if(!this.style.opacity || this.style.opacity !== '0.4') this.style.background='transparent'">
                                                                <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; background: #0A2540; color: white; border-radius: 50%; font-size: 0.65rem; font-weight: 700; flex-shrink: 0;">@initials</span>
                                                                <div style="flex: 1; text-align: left;">
                                                                    <div style="font-weight: 600; color: #0A2540; font-size: 0.8rem;">@s.FullName</div>
                                                                    <div style="font-size: 0.65rem; color: #94A3B8;">@s.Role</div>
                                                                </div>
                                                                @if (isAssigned)
                                                                {
                                                                    <span style="font-size: 0.6rem; color: #10B981; font-weight: 600;">✓ Assigned</span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="display: inline-block; width: 8px; height: 8px; background: #10B981; border-radius: 50%; flex-shrink: 0;"></span>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: #94A3B8; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.375rem;">
                                            <i data-lucide="lock" style="width: 14px; height: 14px;"></i>
                                            Locked
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="padding: 2.5rem 1.25rem; text-align: center; color: #94A3B8;">
                                <i data-lucide="calendar" style="width: 32px; height: 32px; display: block; margin: 0 auto 0.5rem; color: #CBD5E1;"></i>
                                <p style="margin: 0; font-size: 1rem; color: #64748B;">No shifts created for this week</p>
                                <p style="margin: 0.25rem 0 0 0; font-size: 0.875rem; color: #94A3B8;">Use the form above to create your first shift</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Branded Confirmation Modal -->
<div id="confirmModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
    <div style="background: white; border-radius: 16px; padding: 1.75rem; max-width: 420px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.2); animation: modalIn 0.2s ease;">
        <div style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem;">
            <div id="modalIconContainer" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: #FEF3C7; border-radius: 50%; flex-shrink: 0;">
                <i id="modalIcon" data-lucide="user-plus" style="width: 20px; height: 20px; color: #F59E0B;"></i>
            </div>
            <div>
                <h4 id="modalHeading" style="margin: 0; font-size: 1rem; font-weight: 700; color: #0A2540;">Assign staff member?</h4>
                <p id="modalSubtext" style="margin: 0.25rem 0 0 0; font-size: 0.875rem; color: #64748B;">You are about to assign <strong id="confirmStaffName" style="color: #0A2540;"></strong> to:</p>
            </div>
        </div>
        <div style="background: #F8FAFE; border-radius: 12px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; border-left: 3px solid #C1272D;">
            <div style="font-weight: 600; color: #0A2540; font-size: 0.875rem;" id="confirmShiftName"></div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.125rem;" id="confirmShiftDetails"></div>
        </div>
        <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
            <button onclick="closeConfirmModal()" style="padding: 0.5rem 1.5rem; background: #F1F5F9; color: #0A2540; border: none; border-radius: 50px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#E2E8F0'" onmouseout="this.style.background='#F1F5F9'">
                Cancel
            </button>
            <button id="confirmAssignBtn" style="padding: 0.5rem 1.5rem; background: #C1272D; color: white; border: none; border-radius: 50px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#A11E23'" onmouseout="this.style.background='#C1272D'">
                <i data-lucide="check" style="width: 16px; height: 16px; display: inline; margin-right: 0.375rem;"></i>
                Confirm
            </button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    lucide.createIcons();

    // ========================================
    // ON PAGE LOAD TEMP DATA TOAST TRIGGER
    // ========================================
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
            <text>
                showToast('@Html.Raw(TempData["Success"])', 'success', 'Success');
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
                showToast('@Html.Raw(TempData["Error"])', 'error', 'Error');
            </text>
        }
    });

    // ========================================
    // TOAST SYSTEM
    // ========================================
    function showToast(message, type = 'success', title = '', duration = 6000) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');

        const icons = {
            success: 'check-circle',
            error: 'alert-circle',
            warning: 'alert-triangle',
            info: 'info'
        };

        const colors = {
            success: { accent: '#10B981', badgeBg: '#ECFDF5', text: '#065F46' },
            error: { accent: '#C1272D', badgeBg: '#FEF2F2', text: '#991B1B' },
            warning: { accent: '#D97706', badgeBg: '#FFFBEB', text: '#92400E' },
            info: { accent: '#1A4A7A', badgeBg: '#EFF6FF', text: '#1E40AF' }
        };

        const c = colors[type] || colors.success;
        const finalDuration = Math.min(8000, Math.max(4000, duration));

        toast.style.cssText = `
            background: #FFFFFF;
            border: 1px solid #E8E8E8;
            border-left: 4px solid ${c.accent};
            border-radius: 10px;
            padding: 0.9rem 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            animation: toastIn 0.3s ease;
            box-shadow: 0 8px 24px rgba(10,37,64,0.12);
            pointer-events: auto;
            max-width: 380px;
            width: 100%;
        `;

        toast.innerHTML = `
            <span style="display:flex; align-items:center; justify-content:center; width: 32px; height: 32px; border-radius: 50%; background: ${c.badgeBg}; flex-shrink: 0;">
                <i data-lucide="${icons[type] || 'check-circle'}" style="color: ${c.accent}; width: 18px; height: 18px;"></i>
            </span>
            <div style="flex: 1; min-width: 0;">
                ${title ? `<div style="font-weight: 700; color: #0A2540; font-size: 0.875rem;">${title}</div>` : ''}
                <div style="color: ${c.text}; font-size: 0.8rem; line-height: 1.4; ${title ? 'margin-top: 0.15rem;' : ''}">${message}</div>
                <div style="margin-top: 0.5rem; height: 3px; background: #F1F5F9; border-radius: 4px; width: 100%; overflow: hidden;">
                    <div class="toast-progress-bar" style="height: 100%; background: ${c.accent}; border-radius: 4px; width: 100%;"></div>
                </div>
            </div>
            <button onclick="this.closest('[data-toast]').remove()" style="background: none; border: none; color: #94A3B8; cursor: pointer; opacity: 0.7; padding: 0; font-size: 1.2rem; line-height: 1; flex-shrink: 0;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
                <i data-lucide="x" style="width: 16px; height: 16px;"></i>
            </button>
        `;

        toast.setAttribute('data-toast', '');
        container.appendChild(toast);
        lucide.createIcons();

        const progressBar = toast.querySelector('.toast-progress-bar');
        let startTime = Date.now();
        let elapsed = 0;
        let paused = false;
        let remaining = finalDuration;
        let intervalId = null;

        function updateProgress() {
            if (paused) return;
            const now = Date.now();
            elapsed += now - startTime;
            startTime = now;

            const progress = Math.min(1, elapsed / remaining);
            const width = (1 - progress) * 100;
            progressBar.style.width = width + '%';

            if (progress >= 1) {
                clearInterval(intervalId);
                dismissToast();
            }
        }

        function dismissToast() {
            toast.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(() => toast.remove(), 300);
        }

        intervalId = setInterval(updateProgress, 50);

        toast.addEventListener('mouseenter', () => {
            paused = true;
            if (intervalId) clearInterval(intervalId);
        });

        toast.addEventListener('mouseleave', () => {
            paused = false;
            startTime = Date.now();
            remaining = remaining - elapsed;
            elapsed = 0;
            if (remaining <= 0) {
                dismissToast();
            } else {
                intervalId = setInterval(updateProgress, 50);
            }
        });
    }

    // ========================================
    // BRANDED MODAL LOGIC (ASSIGN & PUBLISH)
    // ========================================
    let pendingAssignment = null;
    let pendingPublish = false;

    function openConfirmModal(staffId, staffName, shiftId, shiftName, shiftDate, shiftTime) {
        pendingAssignment = { staffId, shiftId };
        pendingPublish = false;

        document.getElementById('modalHeading').textContent = 'Assign staff member?';
        document.getElementById('modalSubtext').innerHTML = 'You are about to assign <strong style="color: #0A2540;">' + staffName + '</strong> to:';
        document.getElementById('confirmShiftName').textContent = shiftName;
        document.getElementById('confirmShiftDetails').textContent = shiftDate + ' · ' + shiftTime;

        document.getElementById('confirmModal').style.display = 'flex';
        lucide.createIcons();
    }

    function openPublishConfirmModal() {
        pendingAssignment = null;
        pendingPublish = true;

        document.getElementById('modalHeading').textContent = 'Publish Schedule?';
        document.getElementById('modalSubtext').textContent = 'Are you sure you want to publish the draft schedule?';
        document.getElementById('confirmShiftName').textContent = 'All draft shifts for this week';
        document.getElementById('confirmShiftDetails').textContent = 'This will lock all draft shifts for editing.';

        document.getElementById('confirmModal').style.display = 'flex';
        lucide.createIcons();
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').style.display = 'none';
        pendingAssignment = null;
        pendingPublish = false;
    }

    document.getElementById('confirmAssignBtn').addEventListener('click', function() {
        if (pendingAssignment) {
            assignStaff(pendingAssignment.shiftId, pendingAssignment.staffId);
            closeConfirmModal();
        } else if (pendingPublish) {
            document.getElementById('publishForm').submit();
            closeConfirmModal();
        }
    });

    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeConfirmModal();
    });

    function assignStaff(shiftId, staffId) {
        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("AssignStaffToShift", "StaffManager")',
            type: 'POST',
            data: {
                shiftId: shiftId,
                staffId: staffId,
                __RequestVerificationToken: token
            },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    showToast(response.message, 'error', 'Assignment Failed');
                }
            },
            error: function() {
                showToast('Error assigning staff to shift', 'error', 'Assignment Failed');
            }
        });
    }

    // ========================================
    // STAFF PICKER DROPDOWN
    // ========================================
    function positionDropdown(button, dropdown) {
        const rect = button.getBoundingClientRect();
        const dropdownHeight = 300;
        const dropdownWidth = 260;
        const spaceBelow = window.innerHeight - rect.bottom;

        dropdown.style.position = 'fixed';
        dropdown.style.right = 'auto';
        dropdown.style.marginTop = '0';
        dropdown.style.left = Math.min(rect.right - dropdownWidth, window.innerWidth - dropdownWidth - 10) + 'px';

        if (spaceBelow < dropdownHeight && rect.top > dropdownHeight) {
            dropdown.style.top = (rect.top - dropdownHeight - 6) + 'px';
        } else {
            dropdown.style.top = (rect.bottom + 6) + 'px';
        }
    }

    document.querySelectorAll('.staff-picker-toggle').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const dropdown = this.parentElement.querySelector('.staff-picker-dropdown');
            const isOpen = dropdown.style.display === 'block';

            document.querySelectorAll('.staff-picker-dropdown').forEach(d => {
                d.style.display = 'none';
            });

            if (!isOpen) {
                positionDropdown(this, dropdown);
                dropdown.style.display = 'block';

                const search = dropdown.querySelector('.staff-search');
                if (search) {
                    search.value = '';
                    setTimeout(() => search.focus({ preventScroll: true }), 100);
                }
                dropdown.querySelectorAll('.staff-option').forEach(o => o.style.display = 'flex');
                lucide.createIcons();
            }
        });
    });

    window.addEventListener('scroll', function(e) {
        if (e.target && e.target.closest && e.target.closest('.staff-picker-dropdown')) return;
        document.querySelectorAll('.staff-picker-dropdown').forEach(d => d.style.display = 'none');
    }, true);

    document.addEventListener('click', function(e) {
        document.querySelectorAll('.staff-picker-dropdown').forEach(d => {
            if (!d.closest('.staff-picker-wrapper').contains(e.target)) {
                d.style.display = 'none';
            }
        });
    });

    document.querySelectorAll('.staff-option').forEach(opt => {
        opt.addEventListener('click', function() {
            if (this.style.opacity === '0.4' || this.style.cursor === 'not-allowed') return;

            const staffId = this.dataset.staffid;
            const shiftId = this.dataset.shiftid;
            const staffName = this.dataset.name;

            const row = this.closest('tr');
            const shiftName = row.querySelector('td:nth-child(2) div:first-child')?.textContent || 'Shift';
            const shiftDate = row.querySelector('td:first-child')?.textContent || '';
            const shiftTime = row.querySelector('td:nth-child(3)')?.textContent?.trim() || '';

            this.closest('.staff-picker-dropdown').style.display = 'none';
            openConfirmModal(staffId, staffName, shiftId, shiftName, shiftDate, shiftTime);
        });
    });

    document.querySelectorAll('.staff-search').forEach(input => {
        input.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            const options = this.closest('.staff-picker-dropdown').querySelectorAll('.staff-option');
            options.forEach(opt => {
                const name = opt.dataset.name?.toLowerCase() || '';
                opt.style.display = name.includes(query) ? 'flex' : 'none';
            });
        });
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeConfirmModal();
            document.querySelectorAll('.staff-picker-dropdown').forEach(d => {
                d.style.display = 'none';
            });
        }
    });
</script>

<style>
    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translateX(20px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(-10px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes dropdownIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .staff-picker-dropdown {
        display: none;
        position: fixed;
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.12);
        border: 1px solid #E8E8E8;
        min-width: 260px;
        max-height: 300px;
        overflow: hidden;
        z-index: 1000;
        animation: dropdownIn 0.15s ease;
    }

    .staff-list {
        max-height: 220px;
        overflow-y: auto;
        padding: 0.25rem 0;
    }

    .staff-option:hover {
        background: #F8FAFE !important;
    }

    .staff-option:active {
        transform: scale(0.98);
    }
</style>