﻿@{
    ViewBag.Title = "Enterprise Dashboard - Chester Meat Matrix";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalDue = ViewBag.TotalDue as decimal? ?? 0M;
    var customerName = ViewBag.CustomerName as string ?? "Enterprise Customer";
}

<style>
    .enterprise-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(14, 108, 176, 0.1);
        background: white;
        height: 100%;
    }

        .enterprise-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(10, 76, 140, 0.15);
        }

        .enterprise-card .card-header {
            background: linear-gradient(135deg, #0A2540 0%, #1A4A7A 45%, #2C6E9E 100%);
            color: white;
            font-weight: 600;
            padding: 15px 20px;
            font-size: 1.1rem;
        }

        .enterprise-card .card-body {
            padding: 20px;
            min-height: 150px;
            display: flex;
            flex-direction: column;
        }

    .balance-amount {
        font-size: 32px;
        font-weight: 800;
        color: #2C6E9E;
    }

    .btn-enterprise {
        background: linear-gradient(135deg, #0A2540, #1A4A7A);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-weight: 600;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

        .btn-enterprise:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(10, 37, 64, 0.3);
            color: white;
            text-decoration: none;
        }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .welcome-section {
        background: linear-gradient(135deg, #0A2540, #1A4A7A);
        border-radius: 20px;
        padding: 25px 30px;
        margin-bottom: 30px;
        color: white;
    }

        .welcome-section h2 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }
</style>

<div class="container py-4">
    <!-- Welcome Section -->
    <div class="welcome-section">
        <h2>Welcome back, @customerName! 🏢</h2>
        <p>Manage your enterprise account, view balances, and track orders.</p>
    </div>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Account Balance Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-chart-line"></i> Account Balance
            </div>
            <div class="card-body">
                <p class="text-muted">Outstanding balance for your account</p>
                <div class="balance-amount">R @totalDue.ToString("N2")</div>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("AccountBalance", "Enterprise")" class="btn-enterprise w-100">View Balance →</a>
                </div>
            </div>
        </div>

        <!-- Place Order Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-shopping-cart"></i> Place Order
            </div>
            <div class="card-body">
                <p class="text-muted">Browse products and add to your monthly account</p>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("Products", "Customer")" class="btn-enterprise w-100">Shop Now →</a>
                </div>
            </div>
        </div>

        <!-- Track Order Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-truck"></i> Track Order
            </div>
            <div class="card-body">
                <p class="text-muted">Check status of your orders</p>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("TrackOrder", "Enterprise")" class="btn-enterprise w-100">Track Order →</a>
                </div>
            </div>
        </div>

        <!-- NEW: Pending Receipt Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-clipboard-check"></i> Pending Receipt
            </div>
            <div class="card-body">
                <p class="text-muted">Confirm delivery of your orders from drivers</p>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("PendingReceipt", "Enterprise")" class="btn-enterprise w-100">📦 Confirm Receipt →</a>
                </div>
            </div>
        </div>

        <!-- Reports & Analytics Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-chart-bar"></i> Reports & Analytics
            </div>
            <div class="card-body">
                <p class="text-muted">View spending history and charts</p>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("Reports", "Enterprise")" class="btn-enterprise w-100">View Reports →</a>
                </div>
            </div>
        </div>

        <!-- Edit Profile Card -->
        <div class="enterprise-card">
            <div class="card-header">
                <i class="fas fa-user-edit"></i> My Profile
            </div>
            <div class="card-body">
                <p class="text-muted">Update your company and contact details</p>
                <div style="margin-top: auto; padding-top: 15px;">
                    <a href="@Url.Action("EditProfile", "Enterprise")" class="btn-enterprise w-100">Edit Profile →</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">