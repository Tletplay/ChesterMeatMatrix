@model IEnumerable<ChesterMeatMatrix.Models.Order>
@{
    ViewBag.Title = "Reports & Analytics - Chester Meat Matrix";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalSpent = ViewBag.TotalSpent as decimal? ?? 0M;
    var totalOutstanding = ViewBag.TotalOutstanding as decimal? ?? 0M;
    var paidCount = ViewBag.PaidCount as int? ?? 0;
    var unpaidCount = ViewBag.UnpaidCount as int? ?? 0;
}

<style>
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        border: 1px solid #E0E8F0;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

    .stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #0A2540;
    }

    .stat-label {
        font-size: 13px;
        color: #6B7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .chart-container {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #E0E8F0;
    }

        .chart-container h4 {
            color: #0A2540;
            margin-bottom: 20px;
            font-weight: 600;
        }

    canvas {
        max-height: 300px;
        width: 100%;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 16px;
        overflow: hidden;
    }

        .data-table th {
            background: #F0F4F8;
            padding: 12px;
            text-align: left;
            font-weight: 700;
        }

        .data-table td {
            padding: 12px;
            border-bottom: 1px solid #E0E8F0;
        }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #0A2540;">Reports & Analytics</h2>
        <a href="@Url.Action("Index", "Enterprise")" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-value">R @totalSpent:N2</div>
                <div class="stat-label">Total Spent</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-value">R @totalOutstanding:N2</div>
                <div class="stat-label">Total Outstanding</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-value">@paidCount</div>
                <div class="stat-label">Paid Invoices</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-value">@unpaidCount</div>
                <div class="stat-label">Unpaid Invoices</div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row">
        <div class="col-md-7">
            <div class="chart-container">
                <h4><i class="fas fa-chart-line"></i> Monthly Spending</h4>
                <div class="d-flex align-items-center mb-3">
                    <label class="me-2">Months:</label>
                    <select id="monthsSelect" class="form-select" style="width: 100px;">
                        <option value="3">3</option>
                        <option value="6" selected>6</option>
                        <option value="12">12</option>
                    </select>
                    <button id="refreshBtn" class="btn btn-primary btn-sm ms-3">Refresh</button>
                </div>
                <canvas id="barChart" height="250"></canvas>
            </div>
        </div>
        <div class="col-md-5">
            <div class="chart-container">
                <h4><i class="fas fa-chart-pie"></i> Paid vs Unpaid</h4>
                <canvas id="pieChart" height="250"></canvas>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="chart-container">
        <h4><i class="fas fa-file-invoice"></i> Invoice History</h4>
        <div class="table-responsive" style="max-height: 400px; overflow: auto;">
            <table class="data-table">
                <thead>
                    <tr style="position: sticky; top: 0;">
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>R @order.Total:N2</td>
                            <td>@order.PaymentMethodString</td>
                            <td>
                                @if (order.IsPaid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var barChart, pieChart;

    function fetchReportData(months) {
        return $.getJSON('@Url.Action("GetReportData", "Enterprise")?months=' + months);
    }

    function renderCharts(data) {
        // Bar Chart
        var ctxB = document.getElementById('barChart').getContext('2d');
        if (barChart) barChart.destroy();
        barChart = new Chart(ctxB, {
            type: 'bar',
            data: {
                labels: data.labels,
                datasets: [
                    { label: 'Paid', backgroundColor: '#10B981', data: data.paidData },
                    { label: 'Unpaid', backgroundColor: '#F59E0B', data: data.unpaidData }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: { y: { beginAtZero: true, title: { display: true, text: 'Amount (R)' } } }
            }
        });

        // Pie Chart
        var ctxP = document.getElementById('pieChart').getContext('2d');
        if (pieChart) pieChart.destroy();
        pieChart = new Chart(ctxP, {
            type: 'pie',
            data: {
                labels: ['Paid', 'Unpaid'],
                datasets: [{ data: [data.pie.paid, data.pie.unpaid], backgroundColor: ['#10B981', '#F59E0B'] }]
            },
            options: { responsive: true, maintainAspectRatio: true }
        });
    }

    $(function() {
        var months = $('#monthsSelect').val();

        function load(months) {
            fetchReportData(months).done(function(data) {
                if (data.error) { alert(data.error); return; }
                renderCharts(data);
            });
        }

        load(months);

        $('#refreshBtn').click(function() {
            load($('#monthsSelect').val());
        });
    });
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">