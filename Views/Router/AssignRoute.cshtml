﻿@model ChesterMeatMatrix.Models.RouteAssignmentViewModel
@{
    ViewBag.Title = "Assign Route";
    Layout = "~/Views/Shared/_RouterLayout.cshtml";
}

<style>
    * {
        font-family: 'Inter', sans-serif;
    }

    .container-custom {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .header-bar h2 {
            color: #0a4c8c;
            font-weight: 700;
            margin: 0;
        }

    .btn-back {
        background: #64748b;
        padding: 8px 24px;
        border-radius: 40px;
        color: white;
        text-decoration: none;
    }

    .info-card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-left: 4px solid #f59e0b;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 0.8rem;
        text-align: center;
    }

        .stat-card strong {
            display: block;
            font-size: 1.2rem;
            color: #0a4c8c;
        }

    .stop-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 0.8rem;
    }

    .stop-number {
        display: inline-block;
        width: 30px;
        height: 30px;
        background: #0a4c8c;
        color: white;
        border-radius: 50%;
        text-align: center;
        line-height: 30px;
        font-weight: bold;
        margin-right: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            color: #0a4c8c;
            margin-bottom: 0.3rem;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }

    .btn-create {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 40px;
        color: white;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
    }

        .btn-create:hover {
            transform: translateY(-2px);
        }
</style>

<div class="container-custom">
    <div class="header-bar">
        <h2><i class="fas fa-route"></i> Assign Route</h2>
        <a href="@Url.Action("PendingOrders", "Router")" class="btn-back">← Back to Orders</a>
    </div>

    <div class="info-card">
        <i class="fas fa-info-circle"></i> @Model.RestrictionMessage
    </div>

    <div class="stats-grid">
        <div class="stat-card"><strong>@Model.SelectedStopCount</strong> Selected Stops</div>
        <div class="stat-card"><strong>@Model.TotalWeightKg.ToString("N0") kg</strong> Total Weight</div>
        <div class="stat-card"><strong>@Model.TotalPackages</strong> Total Packages</div>
        <div class="stat-card"><strong>@Model.EstimatedDistanceKm.ToString("N1") km</strong> Est. Distance</div>
        <div class="stat-card"><strong>@Model.DistinctAreaCount</strong> Area Types</div>
        <div class="stat-card"><strong>@Model.GeocodedStopCount / @Model.SelectedStopCount</strong> Geocoded</div>
    </div>

    @using (Html.BeginForm("CreateRoute", "Router", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderIds" value="@Model.OrderIds" />

        <div style="background: white; border-radius: 16px; padding: 1rem; margin-bottom: 1.5rem;">
            <h4>Delivery Stops (@Model.Stops.Count stops)</h4>
            @foreach (var stop in Model.Stops)
            {
                <div class="stop-item">
                    <span class="stop-number">@(Model.Stops.IndexOf(stop) + 1)</span>
                    <strong>Order #@stop.OrderNumber</strong><br />
                    <small>@stop.CustomerName</small><br />
                    <small>@stop.DeliveryAddress</small><br />
                    <small>Area: @stop.AreaLabel</small>
                </div>
            }
        </div>

        <div class="form-group">
            <label><i class="fas fa-user"></i> Select Driver</label>
            @Html.DropDownList("driverId", (SelectList)ViewBag.Drivers, "-- Select Driver --", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-truck"></i> Select Vehicle</label>
            @Html.DropDownList("truckId", (SelectList)ViewBag.Trucks, "-- Select Vehicle --", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label><i class="fas fa-calendar"></i> Scheduled Date & Time</label>
            <input type="datetime-local" name="scheduledDateTime" class="form-control" required />
        </div>

        <button type="submit" class="btn-create">Create Route & Assign →</button>
    }
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">