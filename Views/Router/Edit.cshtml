
@using ChesterMeatMatrix.Data
@model ChesterMeatMatrix.Models.Route
@{
    ViewBag.Title = "Edit Route - Chester Meat Matrix";
    Layout = "~/Views/Shared/_RouterLayout.cshtml";
    var drivers = ViewBag.Drivers as System.Collections.Generic.List<ChesterMeatMatrix.Models.User> ?? new System.Collections.Generic.List<ChesterMeatMatrix.Models.User>();
    var vehicles = ViewBag.Vehicles as System.Collections.Generic.List<ChesterMeatMatrix.Models.Vehicle> ?? new System.Collections.Generic.List<ChesterMeatMatrix.Models.Vehicle>();
    var statuses = ViewBag.Statuses as string[] ?? new string[0];
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Chester Meat Matrix - Edit Route</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0A2540 0%, #1A4A7A 50%, #2C6E9E 100%);
            position: relative;
            overflow-x: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        /* Blue Bubble Pattern Overlay */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(circle at 20% 40%, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 30px 30px;
            pointer-events: none;
        }

        /* Floating Bubbles */
        .bubble {
            position: absolute;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.05));
            border-radius: 50%;
            backdrop-filter: blur(3px);
            animation: floatBubble 12s infinite ease-in-out;
            z-index: 0;
            pointer-events: none;
        }

        @@keyframes floatBubble {
            0%, 100% { transform: translateY(0) translateX(0) scale(1); opacity: 0.4; }
            25% { transform: translateY(-40px) translateX(20px) scale(1.05); opacity: 0.6; }
            50% { transform: translateY(-70px) translateX(-15px) scale(1.1); opacity: 0.7; }
            75% { transform: translateY(-30px) translateX(25px) scale(1.05); opacity: 0.5; }
        }

        .bubble-1 { width: 300px; height: 300px; top: -80px; left: -100px; animation-duration: 14s; }
        .bubble-2 { width: 200px; height: 200px; bottom: -50px; right: -80px; animation-duration: 11s; animation-delay: 1s; }
        .bubble-3 { width: 150px; height: 150px; top: 15%; right: 5%; animation-duration: 16s; animation-delay: 2s; }
        .bubble-4 { width: 250px; height: 250px; bottom: 10%; left: -60px; animation-duration: 18s; animation-delay: 0.5s; }
        .bubble-5 { width: 100px; height: 100px; top: 70%; right: 15%; animation-duration: 10s; animation-delay: 3s; }
        .bubble-6 { width: 180px; height: 180px; top: 80%; left: 10%; animation-duration: 13s; animation-delay: 1.5s; }
        .bubble-7 { width: 120px; height: 120px; top: 20%; left: 20%; animation-duration: 9s; animation-delay: 2.5s; }
        .bubble-8 { width: 80px; height: 80px; bottom: 25%; right: 10%; animation-duration: 8s; animation-delay: 4s; }

        /* Edit Container */
        .edit-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        /* Edit Card */
        .edit-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 600px;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(10, 37, 64, 0.1);
            overflow: hidden;
        }

        .edit-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.3);
        }

        /* Blue Accent Border Top */
        .edit-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 20px;
            right: 20px;
            height: 4px;
            background: linear-gradient(90deg, #0A2540, #2C6E9E, #0A2540);
            border-radius: 4px 4px 0 0;
            z-index: 1;
        }

        /* Card Header */
        .card-header {
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            padding: 20px 25px;
            border-bottom: none;
        }

        .card-header h2 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0;
        }

        .card-header p {
            font-size: 13px;
            opacity: 0.8;
            margin-top: 5px;
        }

        /* Card Body */
        .card-body {
            padding: 25px;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #0A2540;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        label i {
            margin-right: 6px;
        }

        input, select {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #E0E8F0;
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: white;
            font-family: inherit;
            color: #0A2540;
        }

        select {
            cursor: pointer;
            background: white;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #2C6E9E;
            box-shadow: 0 0 0 3px rgba(44, 110, 158, 0.15);
        }

        input::placeholder {
            color: #B0C4DE;
        }

        /* Button Group */
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 10px;
        }

        .save-btn {
            flex: 1;
            padding: 14px;
            background: linear-gradient(135deg, #0A2540, #1A4A7A);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            position: relative;
            overflow: hidden;
        }

        .save-btn::before {
            content: '💾';
            position: absolute;
            left: -30px;
            top: 50%;
            transform: translateY(-50%);
            transition: left 0.3s ease;
            font-size: 18px;
        }

        .save-btn:hover::before {
            left: 20px;
        }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(10, 37, 64, 0.35);
            padding-left: 45px;
            background: linear-gradient(135deg, #0D2F4F, #1F5A8E);
        }

        .cancel-btn {
            flex: 1;
            padding: 14px;
            background: #E8F0F8;
            color: #0A2540;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            text-align: center;
            text-decoration: none;
            display: inline-block;
        }

        .cancel-btn:hover {
            background: #D0E0F0;
            transform: translateY(-2px);
            text-decoration: none;
            color: #0A2540;
        }

        /* Route Info Box */
        .route-info {
            background: #F8FBFE;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            border: 1px solid #E0E8F0;
        }

        .route-info h4 {
            color: #0A2540;
            font-size: 14px;
            margin-bottom: 10px;
            font-weight: 800;
        }

        .route-info p {
            color: #4A6F8F;
            font-size: 13px;
            margin-bottom: 5px;
        }

        /* Chester Badge */
        .chester-badge {
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: #0A2540;
            color: white;
            padding: 5px 20px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .edit-card {
                margin: 15px;
            }
            .card-header h2 {
                font-size: 20px;
            }
            .btn-group {
                flex-direction: column;
                gap: 10px;
            }
            .bubble-1, .bubble-2, .bubble-4 {
                opacity: 0.3;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 15px;
            }
            .card-body {
                padding: 20px;
            }
            .save-btn, .cancel-btn {
                padding: 12px;
                font-size: 14px;
            }
            input, select {
                padding: 10px 12px;
                font-size: 13px;
            }
            .bubble {
                opacity: 0.2;
            }
        }
    </style>
</head>
<body>
    <!-- Blue Floating Bubbles -->
    <div class="bubble bubble-1"></div>
    <div class="bubble bubble-2"></div>
    <div class="bubble bubble-3"></div>
    <div class="bubble bubble-4"></div>
    <div class="bubble bubble-5"></div>
    <div class="bubble bubble-6"></div>
    <div class="bubble bubble-7"></div>
    <div class="bubble bubble-8"></div>

    <div class="edit-container">
        <div class="edit-card">
            <div class="card-header">
                <h2>✏️ EDIT ROUTE</h2>
                <p>Update delivery route details</p>
            </div>
            <div class="card-body">
                <!-- Route Info -->
                <div class="route-info">
                    <h4>📍 ROUTE INFORMATION</h4>
                    <p><strong>Route Name:</strong> @Model.Name</p>
                   
                </div>

                @using (Html.BeginForm("Edit", "Router", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.Id)

                    <div class="form-group">
                        <label><i>📍</i> Destination</label>
                        <input type="text"
                               name="destination"
                               value="@Model.Destination"
                               placeholder="Enter destination address"
                               required />
                    </div>

                    <div class="form-group">
                        <label><i>📅</i> Date</label>
                        <input type="date"
                               name="date"
                               value="@(Model.Date > System.DateTime.MinValue ? Model.Date.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="form-group">
                        <label><i>👤</i> Driver</label>
                        <select name="driverId">
                            <option value="">-- Select driver --</option>
                            @foreach (var d in drivers)
                            {
                                <option value="@d.Id" @(Model.AssignedDriverId.HasValue && Model.AssignedDriverId.Value == d.Id ? "selected" : "")>
                                    🚚 @d.FullName (@d.Username)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label><i>🚛</i> Vehicle</label>
                        <select name="vehicleId">
                            <option value="">-- Select vehicle --</option>
                            @foreach (var v in vehicles)
                            {
                                <option value="@v.Id" @(Model.AssignedVehicleId.HasValue && Model.AssignedVehicleId.Value == v.Id ? "selected" : "")>
                                    🚗 @v.Registration - @v.Model
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label><i>⚙️</i> Status</label>
                        <select name="status">
                            @foreach (var s in statuses)
                            {
                                <option value="@s" @(s == Model.Status ? "selected" : "")>@s</option>
                            }
                        </select>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="save-btn">💾 SAVE CHANGES</button>
                        <a href='@Url.Action("RoutedDeliveries", "Router")' class="cancel-btn">✖ CANCEL</a>
                    </div>
                }
            </div>
            <div class="chester-badge">
                CHESTER MEAT MATRIX
            </div>
        </div>
    </div>
</body>
</html>