@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var fullName = Session["FullName"] as string ?? "Admin";
    var role = Session["Role"] as string ?? "Admin";
}

<!DOCTYPE html>        
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>@ViewBag.Title - Chester Meat Matrix Admin</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <style>
        /* Admin Layout Specific Styles - Extending Site.css */
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
            background-color: var(--off-white);
        }

        /* Sidebar */
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, var(--navy-dark) 0%, var(--navy-medium) 100%);
            flex-shrink: 0;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
        }

        .sidebar-header {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-logo-icon {
            font-size: 32px;
        }

        .sidebar-logo-text {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 1px;
            color: white;
        }

        .sidebar-logo-sub {
            font-size: 10px;
            opacity: 0.7;
            color: white;
            margin-top: 4px;
        }

        .sidebar-user {
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.08);
            margin: 0 15px 20px 15px;
            border-radius: var(--radius-md);
        }

        .sidebar-user-name {
            font-weight: 700;
            font-size: 14px;
            color: white;
        }

        .sidebar-user-role {
            font-size: 11px;
            opacity: 0.7;
            color: white;
            margin-top: 4px;
        }

        .nav-menu {
            list-style: none;
            padding: 0 15px;
        }

        .nav-item {
            margin-bottom: 5px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: var(--radius-md);
            transition: all 0.3s ease;
            font-size: 14px;
            font-weight: 500;
        }

            .nav-link:hover {
                background: rgba(255, 255, 255, 0.1);
                color: white;
                text-decoration: none;
            }

            .nav-link.active {
                background: var(--red-primary);
                color: white;
            }

        .nav-icon {
            font-size: 20px;
            width: 28px;
        }

        .sidebar-footer {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            padding: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 30px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            border-radius: var(--radius-md);
            font-size: 14px;
        }

            .logout-link:hover {
                background: rgba(255, 255, 255, 0.1);
                color: white;
                text-decoration: none;
            }

        /* Main Content */
        .admin-main {
            flex: 1;
            margin-left: 280px;
            min-height: 100vh;
        }

        .admin-top-bar {
            background: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--gray-light);
            position: sticky;
            top: 0;
            z-index: 99;
        }

        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--navy-dark);
            margin: 0;
        }

        .header-date {
            font-size: 13px;
            color: var(--text-secondary);
        }

        .admin-content {
            padding: 25px 30px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
                position: fixed;
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-content {
                padding: 15px;
            }

            .admin-top-bar {
                padding: 12px 15px;
            }

            .page-title {
                font-size: 18px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <span class="sidebar-logo-icon">🥩</span>
                    <div>
                        <div class="sidebar-logo-text">CHESTER MEAT</div>
                        <div class="sidebar-logo-sub">Matrix System</div>
                    </div>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="sidebar-user-name">👤 @fullName</div>
                <div class="sidebar-user-role">@role</div>
            </div>

            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="@Url.Action("Dashboard", "Admin")" class="nav-link @(currentAction == "Dashboard" ? "active" : "")">
                        <span class="nav-icon">📊</span>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Admin")" class="nav-link @(currentAction == "Index" ? "active" : "")">
                        <span class="nav-icon">👥</span>
                        <span>Staff Management</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("CreateUser", "Admin")" class="nav-link @(currentAction == "CreateUser" ? "active" : "")">
                        <span class="nav-icon">➕</span>
                        <span>Create Staff</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Reports")">
                        <i class="fas fa-chart-line"></i> Reports
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="@Url.Action("Logout", "Account")" class="logout-link">
                    <span>🚪</span>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="admin-main">
            <div class="admin-top-bar">
                <h1 class="page-title">@ViewBag.Title</h1>
                <span class="header-date">📅 @DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
            </div>
            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>